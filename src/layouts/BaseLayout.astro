---
import NavMenu from '../components/NavMenu.astro';
import Footer  from '../components/Footer.astro';
import { getLocale, localizePath, unlocalizePath, isTranslated, LOCALES } from '../i18n';
import '../styles/global.css';

interface Props {
  title?:       string;
  description?: string;
  gaId?:       string;
  /** Keep this page out of search results (e.g. untranslated locale pages) */
  noindex?:    boolean;
}

const {
  title       = 'Online Card Games – Hearts, Spades, Rummy & More | Vanikar',
  description = 'Play classic card games online or offline with Vanikar. Enjoy Hearts, Spades, Gin Rummy, Cribbage, Big Two, Indian Rummy and more against AI, friends or online players.',
  gaId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID,
  noindex = false,
} = Astro.props;

const locale       = getLocale(Astro.currentLocale);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const basePath     = unlocalizePath(Astro.url.pathname);
const alternates   = isTranslated(basePath)
  ? LOCALES.map(l => ({ lang: l, href: new URL(localizePath(basePath, l), Astro.site) }))
  : [];
---
<!doctype html>
<html lang={locale}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#0d1a0d" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex" />}
  <link rel="canonical" href={canonicalURL} />
  {alternates.map(a => (
    <link rel="alternate" hreflang={a.lang} href={a.href} />
  ))}
  {alternates.length > 0 && (
    <link rel="alternate" hreflang="x-default" href={new URL(basePath, Astro.site)} />
  )}
  <meta property="og:title"       content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type"        content="website" />
  <meta property="og:url"         content={canonicalURL} />
  <meta property="og:site_name"   content="Vanikar Card Games" />
  <meta property="og:image"       content={new URL('/icon-512.png', Astro.site)} />
  <meta name="twitter:card"       content="summary_large_image" />
  <meta name="twitter:image"      content={new URL('/icon-512.png', Astro.site)} />
  <slot name="head" />

  {gaId && (
      <>
        {/* Google Analytics 4 */}
        <script is:inline src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
        <script is:inline set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${gaId}');`}></script>
      </>
    )}

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700;900&family=Inter:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet" />

  <!-- Favicon (app icon) -->
  <link rel="icon"             type="image/png"     href="/favicon-32.png" sizes="32x32" />
  <link rel="icon"             type="image/png"     href="/favicon-16.png" sizes="16x16" />
  <link rel="icon"             type="image/png"     href="/icon-192.png" sizes="192x192" />
  <link rel="apple-touch-icon"                      href="/icon-180.png" />
</head>
<body>
  <NavMenu />
  <main class="main-content">
    <slot />
  </main>
  <Footer />
</body>
</html>
