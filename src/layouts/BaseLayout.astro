---
import NavMenu from '../components/NavMenu.astro';
import Footer  from '../components/Footer.astro';
import { getLocale, localizePath, unlocalizePath, isTranslated, LOCALES } from '../i18n';
import type { Locale } from '../i18n';
import '../styles/global.css';
// Self-hosted variable fonts (one latin woff2 each, font-display: swap) —
// replaces the render-blocking Google Fonts stylesheet.
import '@fontsource-variable/inter';
import '@fontsource-variable/inter/wght-italic.css';
import '@fontsource-variable/cinzel';

interface Props {
  title?:       string;
  description?: string;
  gaId?:       string;
  /** Keep this page out of search results (e.g. untranslated locale pages) */
  noindex?:    boolean;
  /** Locales to advertise via hreflang. Defaults to all; pass a subset so
   *  noindexed translations stay out of the cluster. */
  alternateLocales?: Locale[];
  /** 1200×630 social card, absolute URL or site-relative path. Generated by
   *  scripts/gen-og.mjs into public/og/. */
  image?:      string;
}

const {
  title       = 'Online Card Games – Hearts, Spades, Rummy & More | Vanikar',
  description = 'Play classic card games online or offline — Hearts, Spades, Gin Rummy, Cribbage, Big Two and more — against AI, friends or online players. No ads, ever.',
  gaId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID,
  noindex = false,
  alternateLocales,
  image = '/og/default.png',
} = Astro.props;

// Google truncates titles around 60 characters; drop the brand suffix rather
// than let the keyword tail get cut. Social cards keep the full title.
const docTitle = title.length > 60 ? title.replace(/ \| Vanikar$/, '') : title;
const ogImage  = new URL(image, Astro.site);
const OG_LOCALE: Record<Locale, string> = { en: 'en_US', es: 'es_419', pt: 'pt_BR', fr: 'fr_FR', de: 'de_DE', hi: 'hi_IN', it: 'it_IT', ja: 'ja_JP' };

const locale       = getLocale(Astro.currentLocale);

/* Store picker shown when a generic "download" CTA is clicked on desktop,
   where the visitor's platform cannot be inferred. */
const SP = {
  en: { title: 'Get Card Games by Vanikar', body: 'Pick the store for your device.',
        ios: 'Take me to the App Store', play: 'Take me to Google Play', close: 'Close' },
  es: { title: 'Consigue Card Games by Vanikar', body: 'Elige la tienda de tu dispositivo.',
        ios: 'Llévame a la App Store', play: 'Llévame a Google Play', close: 'Cerrar' },
  pt: { title: 'Baixe o Card Games by Vanikar', body: 'Escolha a loja do seu aparelho.',
        ios: 'Ir para a App Store', play: 'Ir para o Google Play', close: 'Fechar' },
  fr: { title: 'Obtenez Card Games by Vanikar', body: 'Choisissez la boutique de votre appareil.',
        ios: 'Aller sur l’App Store', play: 'Aller sur Google Play', close: 'Fermer' },
  de: { title: 'Hol dir Card Games by Vanikar', body: 'Wähle den Store für dein Gerät.',
        ios: 'Zum App Store', play: 'Zu Google Play', close: 'Schließen' },
  hi: { title: 'Card Games by Vanikar पाएँ', body: 'अपने डिवाइस के लिए स्टोर चुनें।',
        ios: 'App Store पर जाएँ', play: 'Google Play पर जाएँ', close: 'बंद करें' },
  it: { title: 'Scarica Card Games by Vanikar', body: 'Scegli lo store per il tuo dispositivo.',
        ios: 'Vai all’App Store', play: 'Vai a Google Play', close: 'Chiudi' },
  ja: { title: 'Card Games by Vanikarを入手', body: 'お使いの端末のストアを選んでください。',
        ios: 'App Storeへ', play: 'Google Playへ', close: '閉じる' },
}[locale];
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const basePath     = unlocalizePath(Astro.url.pathname);
const hreflangSet  = alternateLocales ?? LOCALES;
const alternates   = isTranslated(basePath) && hreflangSet.length > 1
  ? hreflangSet.map(l => ({ lang: l, href: new URL(localizePath(basePath, l), Astro.site) }))
  : [];
---
<!doctype html>
<html lang={locale}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#0d1a0d" />
  <title>{docTitle}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex" />}
  <link rel="canonical" href={canonicalURL} />
  {alternates.map(a => (
    <link rel="alternate" hreflang={a.lang} href={a.href} />
  ))}
  {alternates.length > 0 && (
    <link rel="alternate" hreflang="x-default" href={new URL(basePath, Astro.site)} />
  )}
  <meta property="og:title"       content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type"        content="website" />
  <meta property="og:url"         content={canonicalURL} />
  <meta property="og:site_name"   content="Vanikar Card Games" />
  <meta property="og:locale"      content={OG_LOCALE[locale]} />
  <meta property="og:image"       content={ogImage} />
  <meta property="og:image:width"  content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt"   content={title} />
  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:title"       content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image"       content={ogImage} />
  <slot name="head" />

  {gaId && (
      <>
        {/* Google Analytics 4 */}
        <script is:inline src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
        <script is:inline set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${gaId}');`}></script>
      </>
    )}

  <!-- Favicon (app icon) -->
  <link rel="icon"             type="image/png"     href="/favicon-32.png" sizes="32x32" />
  <link rel="icon"             type="image/png"     href="/favicon-16.png" sizes="16x16" />
  <link rel="icon"             type="image/png"     href="/icon-192.png" sizes="192x192" />
  <link rel="apple-touch-icon"                      href="/icon-180.png" />
</head>
<body>
  <NavMenu />
  <main class="main-content">
    <slot />
  </main>
  <Footer />

  <!-- Desktop store picker: a generic "download" CTA cannot tell iOS from
       Android on a laptop, so it asks instead of guessing. -->
  <dialog id="store-picker" class="sp" aria-labelledby="sp-title">
    <h2 id="sp-title" class="sp-title">{SP.title}</h2>
    <p class="sp-body">{SP.body}</p>
    <div class="sp-actions">
      <button type="button" data-store="App Store"   class="btn btn-primary sp-btn">{SP.ios}</button>
      <button type="button" data-store="Google Play" class="btn btn-primary sp-btn">{SP.play}</button>
    </div>
    <button type="button" class="sp-close" data-sp-close>{SP.close}</button>
  </dialog>

  <script>
    import { STORES_LIVE, APP_STORE_URL, PLAY_STORE_URL } from '../data/stores';

    const picker = document.getElementById('store-picker') as HTMLDialogElement | null;

    /* iPadOS reports itself as a Mac, so touch points are what separate it. */
    const ua        = navigator.userAgent;
    const isIOS     = /iPad|iPhone|iPod/.test(ua) || (ua.includes('Mac') && navigator.maxTouchPoints > 1);
    const isAndroid = /Android/.test(ua);

    const go = (store: string) => {
      const url = store === 'App Store' ? APP_STORE_URL : PLAY_STORE_URL;
      if (!STORES_LIVE) {          // never send anyone to a placeholder
        alert(`need store url — ${store}`);
        return;
      }
      window.location.href = url;
    };

    document.querySelectorAll<HTMLElement>('[data-store]').forEach(el => {
      el.addEventListener('click', () => {
        const store = el.dataset.store ?? '';

        // Buttons that name one store (and the picker's own two) go straight there.
        if (store === 'App Store' || store === 'Google Play') {
          picker?.close();
          go(store);
          return;
        }

        // Generic CTA: send mobile visitors to their own store, ask on desktop.
        if (isIOS)          go('App Store');
        else if (isAndroid) go('Google Play');
        else if (picker)    picker.showModal();
        else                go('App Store');
      });
    });

    picker?.querySelector('[data-sp-close]')?.addEventListener('click', () => picker.close());
    /* Click on the backdrop (outside the dialog box) closes it too. */
    picker?.addEventListener('click', e => {
      if (e.target === picker) picker.close();
    });
  </script>
</body>
</html>
