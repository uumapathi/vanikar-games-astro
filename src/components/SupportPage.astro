          a: `Premium のすべてが 14 日間ご利用いただけます。${avail} 本すべてのゲーム、オンライン対戦、プライベートテーブルが対象です。アプリを初めて開いた時点で自動的に始まり、カード登録は不要です。` },
        { q: 'トライアルが終わるとどうなりますか？',
          a: '課金は発生しません。お好きな 3 本を無料のまま永続的に保持でき、オフラインでコンピュータと対戦できます。全ラインナップとオンライン対戦をご希望なら、サブスクリプションへどうぞ。' },
        { q: '支払い・解約・返金',
          a: 'サブスクリプションは App Store または Google Play が販売・請求しており、解約と返金もそちらでのみ行えます。端末のサブスクリプション設定をお開きください（アプリの「サブスクリプションの管理」から直接開けます）。解約すると次回以降の更新が止まり、支払い済みの期間が終わるまで Premium はそのままご利用いただけます。' },
        { q: '機種変更後に Premium が見当たらない',
          a: '設定の「購入を復元」をタップしてください。サブスクリプションは端末ではなく Vanikar アカウントに紐づいています。' },
        { q: '無料の 3 本を後から選び直せますか？',
          a: 'いいえ。無料の 3 本は一度きりの選択です。決める前にトライアルですべてお試しいただくか、サブスクリプションですべて解放してください。' },
        { q: '解約すると記録はどうなりますか？',
          a: '残ります。履歴・統計・実績はそのまま保持され、無料の 3 本をオフラインで遊ぶ状態に戻ります。再開すれば、残りも元どおりです。' },
      ]},
      { title: 'アカウント', items: [
        { q: '同じアカウントをスマートフォンとブラウザの両方で使えますか？',
          a: 'はい。ひとつの Vanikar アカウントで両方に対応します。ブラウザ版は開発中で、公開後はモバイルアプリで購入したサブスクリプションがそのまま有効になり、アプリでお持ちのゲームはすべてブラウザ版でも使えます。' },
        { q: '表示名やアバターを変更する',
          a: 'アプリのメニューから My Profile を開いてください。メールアドレスは登録時のもので、ここでは変更できません。変更が必要な場合はご連絡ください。' },
        { q: 'パスワードを忘れた',
          a: 'サインイン画面の「Forgot password?」をタップし、届いたメールに従ってください。' },
        { q: 'アカウントの削除',
          a: 'アプリから削除できます。アカウントのアドレスからご連絡いただければ、こちらで削除することも可能です。削除は取り消せません。また、有効なサブスクリプションはストアの設定で別途解約が必要です。' },
      ]},
      { title: 'そのほか', items: [
        { q: '広告は表示されますか？',
          a: 'いいえ。トライアルにも、無料版にも、Premium にも、この先も表示しません。' },
        { q: 'ボイスチャットが動かない',
          a: 'テーブルの音声は Discord を通しています。アプリに端末のマイク権限があるか、Discord アカウントがアプリで連携済みかをご確認ください。' },
      ]},
    ],
    quickMore: 'プランと料金について →',
    h2Other: 'そのほかのお問い合わせ',
    otherPre: '報道・ビジネス・法務のお問い合わせ：',
  },
}[lang];

const homeHref = rootHref('/', lang);
const pageUrl  = new URL(rootHref('/support', lang), Astro.site).href;
const crumbs   = [{ name: t('nav.home'), href: homeHref }, { name: t('footer.support') }];
const allFaqs  = L.groups.flatMap(g => g.items);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: crumbs[0].name, item: new URL(homeHref, Astro.site).href },
      { '@type': 'ListItem', position: 2, name: crumbs[1].name, item: pageUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: allFaqs.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    url: pageUrl,
    name: L.h1,
    description: L.description,
    inLanguage: lang,
    mainEntity: {
      '@type': 'Organization',
      name: 'Vanikar LLC',
      url: 'https://vanikar.com',
      logo: new URL('/vanikar-icon-180.png', Astro.site).href,
      contactPoint: [{
        '@type': 'ContactPoint',
        contactType: 'customer support',
        email: SUPPORT_EMAIL,
        availableLanguage: ['en', 'es', 'pt', 'fr', 'de', 'hi', 'it', 'ja'],
      }],
    },
  },
];
---
<BaseLayout
  title={L.title}
  description={L.description}
  image="/og/vanikar.png"
>
  <Fragment slot="head">
    {jsonLd.map(schema => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </Fragment>

  <section class="legal-page support-page">
    <div class="container-narrow">
      <div class="page-crumbs"><Breadcrumb items={crumbs} /></div>
      <div class="legal-header">
        <h1>{L.h1}</h1>
        <p class="legal-date">{L.subtitle}</p>
      </div>

      <div class="legal-content">
        <p>{L.lead}</p>

        {/* The address is plain text as well as a link: a mailto: does nothing
            on a machine with no mail client configured, and someone reading on
            a phone may want to type it into webmail. */}
        <div class="contact-card">
          <div class="contact-label">{L.emailLabel}</div>
          <a class="contact-email" href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a>
          <p class="contact-note">{L.emailNote}</p>
        </div>

        <h2>{L.h2Faq}</h2>
        <p>{L.faqLead}</p>
        {/* <details> rather than scripted panels: it opens without JavaScript,
            is keyboard-navigable for free, and browser find-in-page can search
            closed answers. Same markup and styling as the FAQs elsewhere. */}
        {L.groups.map(group => (
          <Fragment>
            <h3 class="faq-group">{group.title}</h3>
            <div class="faq-list">
              {group.items.map(f => (
                <details class="faq-item">
                  <summary>{f.q}</summary>
                  <p>{f.a}</p>
                </details>
              ))}
            </div>
          </Fragment>
        ))}
        <p><a href={href('/pricing')}>{L.quickMore}</a></p>

        <h2>{L.h2Include}</h2>
        <p>{L.includeLead}</p>
        <ul>{L.include.map(item => <li>{item}</li>)}</ul>

        <h2>{L.h2Other}</h2>
        <p>{L.otherPre} <a href={`mailto:${COMPANY_EMAIL}`}>{COMPANY_EMAIL}</a>.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-crumbs { margin-bottom: 1.5rem; }
  .contact-card {
    margin: 1.75rem 0 2.5rem; padding: 1.5rem 1.25rem; text-align: center;
    background: var(--gold-subtle, rgba(201,162,39,.07));
    border: 1px solid var(--gold-border, rgba(201,162,39,.3));
    border-radius: var(--radius-md, 10px);
  }
  .contact-label {
    font-size: .72rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: .18em; color: var(--text-muted); margin-bottom: .6rem;
  }
  /* Not Cinzel: it is an all-caps face, and an address rendered
     SUPPORT@VANIKAR.GAMES reads as though the case mattered. */
  .contact-email {
    font-family: 'Inter Variable', sans-serif; font-size: 1.25rem; font-weight: 700;
    color: var(--gold-light); text-decoration: none; overflow-wrap: anywhere;
  }
  .contact-email:hover { text-decoration: underline; text-underline-offset: 4px; }
  .contact-note { font-size: .82rem; color: var(--text-muted); margin: .7rem 0 0; }

  /* Matches the accordion on the home, pricing and game pages. */
  .faq-group {
    font-size: .72rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: .18em; color: var(--text-muted);
    margin: 2rem 0 .85rem; font-family: 'Inter Variable', sans-serif;
  }
  .faq-list { margin-bottom: .5rem; }
  .faq-item {
    border: 1px solid var(--border); border-radius: var(--radius-md);
    background: var(--bg-card); margin-bottom: .6rem; overflow: hidden;
  }
  .faq-item summary {
    cursor: pointer; padding: .9rem 1.15rem; font-size: .92rem; font-weight: 600;
    color: var(--text-primary); font-family: 'Inter Variable', sans-serif;
    list-style: none; position: relative; padding-right: 2.2rem;
    transition: color var(--transition);
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after {
    content: '+'; position: absolute; right: 1.1rem; top: 50%; translate: 0 -50%;
    color: var(--gold); font-size: 1.1rem; transition: transform var(--transition);
  }
  .faq-item[open] summary::after { transform: rotate(45deg); }
  .faq-item summary:hover { color: var(--gold-light); }
  .faq-item p {
    padding: 0 1.15rem 1rem; margin: 0;
    font-size: .88rem; color: var(--text-secondary); line-height: 1.7;
  }
</style>
