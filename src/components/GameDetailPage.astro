import BaseLayout  from '../layouts/BaseLayout.astro';
import ScreenshotLightbox from './ScreenshotLightbox.astro';
import Breadcrumb from './Breadcrumb.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { games, getGame } from '../data/games';
import { localizeGame, isGameFullyLocalized } from '../data/games.i18n';
import { getLocale, localizedHref, localizePath, LOCALES } from '../i18n';
import { launchCopy } from '../data/launch';

interface Props { slug: string }
const { slug } = Astro.props;

const lang = getLocale(Astro.currentLocale);
const LN = launchCopy(lang);
const href = (p: string) => localizedHref(p, lang);
const game = localizeGame(getGame(slug)!, lang);

const iconModules = import.meta.glob<{ default: ImageMetadata }>('../assets/game-icons/*.{png,svg}', { eager: true });
const gameIcon = (s: string) =>
  iconModules[`../assets/game-icons/${s}.png`]?.default ??
  iconModules[`../assets/game-icons/${s}.svg`]?.default;

const shotModules = import.meta.glob<{ default: ImageMetadata }>('../assets/screenshots/*/*.png', { eager: true });
const shots = (game.screenshots ?? [])
  .map(s => {
    const mod = shotModules[`../assets/screenshots/${s.file}`];
    return mod ? { ...s, image: mod.default } : null;
  })
  .filter((s): s is Exclude<typeof s, null> => s !== null);

const diffColor: Record<string, string> = {
  Easy: '#2d6a2d', Medium: '#7a5a10', Hard: '#6a1a1a',
};
const diffLabel: Record<string, string> = {
  en: game.difficulty,
  es: ({ Easy: 'Fácil', Medium: 'Media', Hard: 'Difícil' } as Record<string, string>)[game.difficulty],
  pt: ({ Easy: 'Fácil', Medium: 'Média', Hard: 'Difícil' } as Record<string, string>)[game.difficulty],
  fr: ({ Easy: 'Facile', Medium: 'Moyen', Hard: 'Difficile' } as Record<string, string>)[game.difficulty],
  de: ({ Easy: 'Leicht', Medium: 'Mittel', Hard: 'Schwer' } as Record<string, string>)[game.difficulty],
  hi: ({ Easy: 'आसान', Medium: 'मध्यम', Hard: 'कठिन' } as Record<string, string>)[game.difficulty],
