    hGuide: '📖 विस्तृत गाइड', hScoring: `📊 ${n} की स्कोरिंग`, hFaq: `❓ ${n} — अक्सर पूछे जाने वाले सवाल`,
    quickFacts: 'एक नज़र में', factPlayers: 'खिलाड़ी', factDifficulty: 'कठिनाई', factTier: 'स्तर',
