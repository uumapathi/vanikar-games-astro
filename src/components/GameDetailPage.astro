        ],
  },
}[lang];

/* Per-game SEO overrides + game-specific FAQs (English pages only) */
const pageTitle = (lang === 'en' && game.seo?.title) ? game.seo.title : L.pageTitle;
const heroTitle = (lang === 'en' && game.seo?.h1)    ? game.seo.h1    : L.heroTitle;
const faqs    = (lang === 'en' && game.extraFaqs) ? [...L.faqs, ...game.extraFaqs] : L.faqs;
const pageUrl = `https://vanikar.games${localizePath(`/games/${game.slug}`, lang)}/`;
const ogImage = `/og/${game.slug}.png`;   // generated by scripts/gen-og.mjs

/* Contextual related games (fallback: first four other games) */
const related = (game.relatedGames ?? [])
  .map(s => games.find(g => g.slug === s))
  .filter((g): g is typeof games[number] => !!g);
const otherGames = related.length ? related : games.filter(g => g.slug !== game.slug).slice(0, 4);
const otherTitle = related.length
  ? { en: 'Related Games', es: 'Juegos relacionados', pt: 'Jogos relacionados',
      fr: 'Jeux similaires', de: 'Ähnliche Spiele', hi: 'मिलते-जुलते गेम' }[lang]
  : L.moreGames;

/* Untranslated locale pages stay out of search until fully localized */
const noindex = !isGameFullyLocalized(game.slug, lang);
// hreflang must only point at indexable URLs -- Google drops clusters that
// contain noindexed members, so advertise just the fully translated locales.
const alternateLocales = LOCALES.filter(l => isGameFullyLocalized(game.slug, l));

/* Launch-notification signup (same Google Form as the download section) */
/* ── How-to-play video embed ─────────────────────────────────────── */
const videoHeading = {
  en: `🎬 Watch: How to Play ${n}`,
  es: `🎬 Vídeo: cómo jugar ${n}`,
  pt: `🎬 Vídeo: como jogar ${n}`,
  fr: `🎬 Vidéo : comment jouer à ${n}`,
  de: `🎬 Video: So spielst du ${n}`,
  hi: `🎬 वीडियो: ${n} कैसे खेलें`,
}[lang];
const videoSrc = game.video
  ? `https://www.youtube-nocookie.com/embed/${game.video.youtubeId}${game.video.start ? `?start=${game.video.start}` : ''}`
  : null;
const playLabel = { en: 'Play video', es: 'Reproducir vídeo', pt: 'Reproduzir vídeo', fr: 'Lire la vidéo', de: 'Video abspielen', hi: 'वीडियो चलाएँ' }[lang];
const videoDisclaimer = {
  en: 'This video is embedded from YouTube and remains the intellectual property of its respective creator and/or rights holder. Vanikar LLC claims no ownership of, or rights in, the video content, and no affiliation with or endorsement by its creator is implied. The video is displayed via YouTube’s public embed feature in accordance with the YouTube Terms of Service and the agreements between YouTube and the content uploader.',
  es: 'Este vídeo se muestra desde YouTube y sigue siendo propiedad intelectual de su creador o titular de derechos correspondiente. Vanikar LLC no reclama ninguna titularidad ni derecho sobre este contenido, y no se implica afiliación alguna con su creador ni respaldo por su parte. El vídeo se reproduce mediante la función pública de inserción de YouTube, de conformidad con las Condiciones del Servicio de YouTube y los acuerdos entre YouTube y quien subió el contenido.',
  pt: 'Este vídeo é exibido a partir do YouTube e permanece propriedade intelectual do respectivo criador e/ou detentor dos direitos. A Vanikar LLC não reivindica qualquer titularidade ou direito sobre este conteúdo, e não se implica qualquer afiliação com o criador nem endosso da parte dele. O vídeo é reproduzido por meio do recurso público de incorporação do YouTube, em conformidade com os Termos de Serviço do YouTube e os acordos entre o YouTube e quem enviou o conteúdo.',
  fr: 'Cette vidéo est diffusée depuis YouTube et demeure la propriété intellectuelle de son créateur ou de l’ayant droit concerné. Vanikar LLC ne revendique aucun droit sur ce contenu, et aucune affiliation avec son créateur ni aucun parrainage de sa part ne saurait en être déduit. La vidéo est affichée au moyen de la fonction d’intégration publique de YouTube, conformément aux Conditions d’utilisation de YouTube et aux accords conclus entre YouTube et le déposant du contenu.',
  de: 'Dieses Video wird von YouTube eingebunden und verbleibt geistiges Eigentum des jeweiligen Urhebers bzw. Rechteinhabers. Vanikar LLC beansprucht keinerlei Eigentum oder Rechte an diesem Inhalt; eine Verbindung zum Urheber oder dessen Befürwortung wird nicht impliziert. Die Anzeige erfolgt über die öffentliche Einbettungsfunktion von YouTube im Einklang mit den Nutzungsbedingungen von YouTube und den Vereinbarungen zwischen YouTube und dem Uploader.',
  hi: 'यह वीडियो YouTube से एम्बेड किया गया है और इसकी बौद्धिक संपदा संबंधित निर्माता और/या अधिकार धारक की ही रहती है। Vanikar LLC इस वीडियो सामग्री पर किसी स्वामित्व या अधिकार का दावा नहीं करता, और निर्माता से किसी संबद्धता या समर्थन का कोई निहितार्थ नहीं है। यह वीडियो YouTube की सार्वजनिक एम्बेड सुविधा के माध्यम से, YouTube की सेवा शर्तों तथा YouTube और सामग्री अपलोडर के बीच के अनुबंधों के अनुसार प्रदर्शित किया गया है।',
}[lang];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: L.breadcrumbHome,  item: `https://vanikar.games${localizePath('/', lang)}` },
      { '@type': 'ListItem', position: 2, name: L.breadcrumbGames, item: `https://vanikar.games${localizePath('/games', lang)}/` },
      { '@type': 'ListItem', position: 3, name: game.name, item: pageUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'VideoGame',
    name: game.name,
    ...(game.alternateNames?.length ? { alternateName: game.alternateNames } : {}),
    description: game.description,
    url: pageUrl,
    image: `https://vanikar.games${ogImage}`,
    inLanguage: lang,
    gamePlatform: ['iOS', 'Android'],
    applicationCategory: 'Game',
    genre: 'Card Game',
    playMode: ['SinglePlayer', 'MultiPlayer'],
    numberOfPlayers: { '@type': 'QuantitativeValue', name: game.playerCount },
    publisher: { '@type': 'Organization', name: 'Vanikar LLC', url: 'https://vanikar.com' },
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD', description: L.trialOffer },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  title={pageTitle}
  description={L.pageDescription}
  noindex={noindex}
  alternateLocales={alternateLocales}
  image={ogImage}
>
  <Fragment slot="head">
    {jsonLd.map(schema => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </Fragment>
  {game.comingSoon && (
    <div class="soon-banner" role="alert">
      <span class="soon-banner-icon">🚀</span>
      <div>
        <strong>{L.soonBannerTag}</strong> — {L.soonBanner}
      </div>
      <a href={href('/pricing')} class="soon-banner-link">{L.soonBannerLink}</a>
    </div>
  )}

  <!-- Breadcrumb (mirrors the BreadcrumbList JSON-LD above) -->
  <div class="back-bar">
    <div class="container">
      <Breadcrumb items={[
        { name: L.breadcrumbHome,  href: href('/') },
        { name: L.breadcrumbGames, href: href('/games') },
        { name: game.name },
      ]} />
    </div>
  </div>

  <!-- Game hero -->
  <section class="game-hero">
    <div class="container">
      <div class="game-hero-inner">
        <div class="game-icon-lg">
          {gameIcon(game.slug)
            ? <Image src={gameIcon(game.slug)!} alt={`${game.name} icon`} width={192} class="gi-img" loading="eager" fetchpriority="high" />
            : game.icon}
        </div>
        <div>
          <div class="game-badges">
            <span class="diff-badge" style={`background:${diffColor[game.difficulty]}22;color:${diffColor[game.difficulty]};border:1px solid ${diffColor[game.difficulty]}55`}>
              {diffLabel[lang]}
            </span>
            <span class="tier-badge tier-premium">{L.premium}</span>
          </div>
          <h1 class="game-title">{heroTitle}</h1>
          <p class="game-tagline">{game.tagline}</p>
          <div class="game-meta">
            <span>👥 {game.players}</span>
            <span class="meta-sep">·</span>
            <span>{L.heroDifficulty}</span>
          </div>
        </div>
      </div>
      <p class="game-description">{game.description}</p>
    </div>
  </section>

  <!-- Content -->
  <section class="game-content">
    <div class="container game-layout">

      <!-- Main column -->
      <div class="game-main">

        <div class="game-section ways-to-play">
          <h2>{L.waysTitle}</h2>
          <div class="ways-grid">
            <div class="way-card">
              <h3>{L.wayOnlineH}</h3>
              <p>{L.wayOnlineP}</p>
            </div>
            <div class="way-card">
              <h3>{L.wayFriendsH}</h3>
              <p>{L.wayFriendsP}</p>
            </div>
            <div class="way-card">
              <h3>{L.wayCpuH}</h3>
              <p>{L.wayCpuP}</p>
            </div>
            <div class="way-card">
              <h3>{L.wayOfflineH}</h3>
              <p>{L.wayOfflineP}</p>
            </div>
          </div>
        </div>

        <div class="game-section">
          <h2>{L.hObjective}</h2>
          <p>{game.objective}</p>
        </div>

        <div class="game-section">
          <h2>{L.hSetup}</h2>
          <ol class="styled-list">
            {game.setup.map(step => <li>{step}</li>)}
          </ol>
        </div>

        <div class="game-section">
          <h2>{L.hHowTo}</h2>
          <ol class="styled-list">
            {game.gameplay.map(step => <li>{step}</li>)}
          </ol>
        </div>

        {videoSrc && (
          <div class="game-section">
            <h2>{videoHeading}</h2>
            {game.video?.note && <p class="video-note">{game.video.note}</p>}
            {/* Click-to-play facade: the real iframe (~500 KB) is only created on click */}
            <div class="video-frame yt-lite"
                 data-yt-id={game.video!.youtubeId}
                 data-yt-start={game.video!.start ?? 0}
                 data-yt-title={videoHeading}>
              <img class="yt-thumb"
                   src={`https://i.ytimg.com/vi/${game.video!.youtubeId}/hqdefault.jpg`}
                   alt="" width="480" height="360" loading="lazy" decoding="async" />
              <button type="button" class="yt-play" aria-label={playLabel}>
                <svg viewBox="0 0 68 48" width="68" height="48" aria-hidden="true">
                  <path class="yt-play-bg" d="M66.5 7.7c-.8-2.9-3-5.2-5.9-6C55.4 0 34 0 34 0S12.6 0 7.4 1.7c-2.9.8-5.1 3.1-5.9 6C0 13 0 24 0 24s0 11 1.5 16.3c.8 2.9 3 5.2 5.9 6C12.6 48 34 48 34 48s21.4 0 26.6-1.7c2.9-.8 5.1-3.1 5.9-6C68 35 68 24 68 24s0-11-1.5-16.3z"/>
                  <path d="M45 24 27 14v20z" fill="#fff"/>
                </svg>
              </button>
              <noscript>
                <iframe src={videoSrc} title={videoHeading} loading="lazy"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                  referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
              </noscript>
            </div>
            <p class="video-disclaimer">{videoDisclaimer}</p>
          </div>
        )}

        {game.playGuide && (
          <div class="game-section">
            <h2>{L.hGuide}</h2>
            {game.playGuide.map(sec => (
              <div class="guide-sub">
                <h3>{sec.heading}</h3>
                <ul class="guide-list">
                  {sec.points.map(p => <li>{p}</li>)}
                </ul>
              </div>
            ))}
          </div>
        )}

        <div class="game-section">
          <h2>{L.hScoring}</h2>
          <p>{game.scoring}</p>
        </div>

        <div class="game-section">
          <h2>{L.hFaq}</h2>
          {faqs.map(f => (
            <details class="faq-item">
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>

      </div>

      <!-- Sidebar -->
      <aside class="game-sidebar">

        <div class="sidebar-card">
          <h3>{L.quickFacts}</h3>
          <dl class="fact-list">
            <dt>{L.factPlayers}</dt><dd>{game.playerCount}</dd>
            <dt>{L.factDifficulty}</dt>
            <dd>
              <span class="diff-badge" style={`background:${diffColor[game.difficulty]}22;color:${diffColor[game.difficulty]};border:1px solid ${diffColor[game.difficulty]}55`}>
                {diffLabel[lang]}
              </span>
            </dd>
            <dt>{L.factTier}</dt>
            <dd>
              <span class="tier-badge tier-premium">{L.premium}</span>
            </dd>
          </dl>
        </div>

        <div class="sidebar-card">
          <h3>{L.tipsTitle}</h3>
          <ul class="tips-list">
            {game.tips.map(tip => <li>{tip}</li>)}
          </ul>
        </div>

        <div class="sidebar-card sidebar-cta">
          <p>{L.sidebarCta}</p>
          <a href={href('/#download')} class="btn btn-primary" style="width:100%;justify-content:center;margin-top:.75rem">
            {LN.gameCta(n)}
          </a>
          <a href={href('/pricing')} class="btn btn-secondary" style="width:100%;justify-content:center;margin-top:.5rem">
            {L.ctaPricing}
          </a>
        </div>

      </aside>

    </div>
  </section>

  {shots.length > 0 && (
    <section class="shots-section">
      <div class="container">
        <h2 class="shots-title">{L.shotsTitle}</h2>
        <p class="shots-sub">{L.shotsSub}</p>
        <div class="shots-grid">
          {shots.map((s, i) => (
            <figure class="shot-card">
              <button class="shot-zoom" data-idx={i} aria-label={`View ${s.title} screenshot full size`}>
                <Image
                  src={s.image}
                  alt={`${game.name} — ${s.title}`}
                  width={640}
                  widths={[240, 420, 640]}
                  sizes="(max-width: 640px) 85vw, (max-width: 1100px) 44vw, 300px"
                  quality={70}
                  class="shot-img"
                />
              </button>
              <figcaption>
                <strong>{s.title}</strong>
                <span>{s.caption}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
      <ScreenshotLightbox shots={shots} altPrefix={game.name} />
    </section>
  )}

  <!-- Other games -->
  <section class="other-games">
    <div class="container">
      <h2 class="other-title">{otherTitle}</h2>
      <div class="other-grid">
        {otherGames.map(g => localizeGame(g, lang)).map(g => (
          <a href={href(`/games/${g.slug}/`)} class="other-card">
            <span class="other-icon">
              {gameIcon(g.slug)
                ? <Image src={gameIcon(g.slug)!} alt="" width={56} class="gi-img" />
                : g.icon}
            </span>
            <span class="other-name">{g.name}</span>
            <span class="other-arrow">›</span>
          </a>
        ))}
      </div>
      <div style="text-align:center;margin-top:1.5rem">
        <a href={href('/games')} class="btn btn-secondary">{L.viewAll}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .soon-banner {
    display: flex; align-items: center; gap: 1rem; flex-wrap: wrap;
    background: rgba(120,80,200,.12); border-bottom: 2px solid rgba(180,144,245,.4);
    padding: 1rem 1.5rem; font-size: .9rem; color: #c8aaff;
  }
  .soon-banner strong { color: #b490f5; }
  .soon-banner-icon   { font-size: 1.4rem; flex-shrink: 0; }
  .soon-banner-link   { margin-left: auto; font-size: .82rem; color: #b490f5; text-decoration: underline; white-space: nowrap; }
  .back-bar  { background: var(--bg-deep); border-bottom: 1px solid var(--border); padding: .75rem 0; }
  .back-link { font-size: .85rem; color: var(--text-muted); transition: color var(--transition); }
  .back-link:hover { color: var(--gold-light); }

  .game-hero {
    background: linear-gradient(180deg, var(--bg-deep) 0%, var(--bg-primary) 100%);
    padding: 3rem 0 2.5rem; border-bottom: 1px solid var(--border);
  }
  .game-hero-inner { display: flex; align-items: flex-start; gap: 1.5rem; margin-bottom: 1.25rem; flex-wrap: wrap; }
  .game-icon-lg   { font-size: 4rem; line-height: 1; }
  .game-icon-lg :global(.gi-img) { width: 96px; height: 96px; object-fit: contain; display: block; }
  .game-badges    { display: flex; gap: .5rem; margin-bottom: .5rem; flex-wrap: wrap; }

  .diff-badge { display: inline-block; font-size: .7rem; font-weight: 700; text-transform: uppercase; letter-spacing: .1em; padding: .2rem .6rem; border-radius: var(--radius-full); }
  .tier-badge { display: inline-block; font-size: .7rem; font-weight: 700; text-transform: uppercase; letter-spacing: .1em; padding: .2rem .6rem; border-radius: var(--radius-full); }
  .tier-premium { background: rgba(201,162,39,.15); color: var(--gold); border: 1px solid var(--gold-border); }

  .game-title   { font-size: clamp(1.8rem,4vw,2.8rem); margin-bottom: .35rem; }
  .game-tagline { font-size: 1.05rem; color: var(--text-secondary); margin-bottom: .5rem; }
  .game-meta    { display: flex; align-items: center; gap: .5rem; font-size: .85rem; color: var(--text-dim); }
  .meta-sep     { color: var(--border); }
  .game-description { font-size: 1rem; color: var(--text-muted); line-height: 1.8; max-width: 760px; }

  .game-content { padding: 3rem 0 4rem; }
  .game-layout  {
    display: grid; grid-template-columns: 1fr 320px; gap: 3rem; align-items: start;
  }
  .game-section { margin-bottom: 2.5rem; }

  /* Video embed */
  /* (facade → real player is swapped in by the script at the bottom of this file) */
  .video-frame {
    position: relative; aspect-ratio: 16 / 9;
    border-radius: var(--radius-lg); overflow: hidden;
    border: 1px solid var(--border); background: #000;
  }
  .video-frame iframe {
    position: absolute; inset: 0; width: 100%; height: 100%; border: 0;
  }
  .yt-thumb { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .yt-play {
    position: absolute; inset: 0; margin: auto; width: 68px; height: 48px;
    padding: 0; border: 0; background: none; cursor: pointer;
  }
  .yt-play-bg { fill: #212121; fill-opacity: .8; transition: fill var(--transition), fill-opacity var(--transition); }
  .yt-lite:hover .yt-play-bg, .yt-play:focus-visible .yt-play-bg { fill: #f00; fill-opacity: 1; }
  .video-note {
    margin: -.35rem 0 .85rem; font-size: .82rem !important;
    color: var(--text-muted) !important; line-height: 1.6 !important;
  }
  .video-disclaimer {
    margin-top: .65rem; font-size: .72rem !important; color: var(--text-dim) !important;
    line-height: 1.6 !important; font-style: italic;
  }
  .game-section h2 {
    font-size: 1.15rem; color: var(--text-primary); margin-bottom: .85rem;
    padding-bottom: .5rem; border-bottom: 1px solid var(--border);
    font-family: 'Inter Variable',sans-serif; font-weight: 700;
  }
  .game-section p  { color: var(--text-secondary); line-height: 1.8; }

  .styled-list { list-style: decimal; padding-left: 1.4rem; color: var(--text-secondary); line-height: 1.9; }
  .styled-list li { margin-bottom: .35rem; }

  /* Ways to play */
  .ways-grid { display: grid; grid-template-columns: 1fr 1fr; gap: .85rem; }
  .way-card {
    background: var(--bg-card); border: 1px solid var(--border);
    border-radius: var(--radius-md); padding: 1rem 1.1rem;
  }
  .way-card h3 {
    font-size: .92rem; font-weight: 700; color: var(--gold-light);
    font-family: 'Inter Variable',sans-serif; margin-bottom: .4rem;
  }
  .way-card p { font-size: .85rem; color: var(--text-secondary); line-height: 1.65; }
  @media (max-width: 640px) { .ways-grid { grid-template-columns: 1fr; } }

  /* FAQ */
  .faq-item {
    border: 1px solid var(--border); border-radius: var(--radius-md);
    background: var(--bg-card); margin-bottom: .6rem; overflow: hidden;
  }
  .faq-item summary {
    cursor: pointer; padding: .85rem 1.1rem; font-size: .9rem; font-weight: 600;
    color: var(--text-primary); font-family: 'Inter Variable',sans-serif;
    transition: color var(--transition); list-style: none; position: relative; padding-right: 2.2rem;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after {
    content: '+'; position: absolute; right: 1.1rem; top: 50%; translate: 0 -50%;
    color: var(--gold); font-size: 1.1rem; transition: transform var(--transition);
  }
  .faq-item[open] summary::after { transform: rotate(45deg); }
  .faq-item summary:hover { color: var(--gold-light); }
  .faq-item p { padding: 0 1.1rem .95rem; font-size: .875rem; color: var(--text-secondary); line-height: 1.7; }

  /* Detailed guide */
  .guide-sub { margin-bottom: 1.75rem; }
  .guide-sub h3 {
    font-size: .95rem; font-weight: 700; color: var(--gold-light);
    font-family: 'Inter Variable',sans-serif; margin-bottom: .5rem;
  }
  .guide-list { list-style: disc; padding-left: 1.4rem; color: var(--text-secondary); line-height: 1.8; }
  .guide-list li { margin-bottom: .4rem; }

  /* Screenshots */
  .shots-section { background: var(--bg-deep); border-top: 1px solid var(--border); padding: 3.5rem 0; }
  .shots-title   { font-size: 1.4rem; margin-bottom: .35rem; }
  .shots-sub     { font-size: .9rem; color: var(--text-muted); margin-bottom: 1.75rem; }
  .shots-grid    {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 1.25rem;
  }
  .shot-card { margin: 0; background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; transition: all var(--transition); }
  .shot-card:hover { border-color: var(--gold-border); transform: translateY(-2px); box-shadow: var(--shadow-md); }
  .shot-card :global(.shot-img) { display: block; width: 100%; height: auto; }
  .shot-zoom { display: block; width: 100%; padding: 0; margin: 0; background: none; border: none; cursor: zoom-in; }
  .shot-card figcaption { padding: .85rem 1rem 1rem; }
  .shot-card figcaption strong { display: block; font-size: .85rem; color: var(--text-primary); font-family: 'Inter Variable',sans-serif; margin-bottom: .25rem; }
  .shot-card figcaption span   { font-size: .78rem; color: var(--text-muted); line-height: 1.55; }

  /* Sidebar */
  .sidebar-card {
    background: var(--bg-card); border: 1px solid var(--border);
    border-radius: var(--radius-lg); padding: 1.25rem; margin-bottom: 1rem;
  }
  .sidebar-card h3 { font-size: .9rem; font-weight: 700; color: var(--text-primary); margin-bottom: .85rem; font-family: 'Inter Variable',sans-serif; }
  .sidebar-cta     { background: var(--gold-subtle); border-color: var(--gold-border); }

  /* Launch notification signup */
  .sidebar-cta p   { font-size: .875rem; color: var(--text-secondary); }

  .fact-list       { display: grid; grid-template-columns: auto 1fr; gap: .5rem .75rem; font-size: .875rem; align-items: start; }
  .fact-list dt    { color: var(--text-dim); padding-top: .15rem; }
  .fact-list dd    { color: var(--text-primary); }

  .tips-list       { list-style: none; padding: 0; }
  .tips-list li    { font-size: .875rem; color: var(--text-secondary); line-height: 1.65; padding: .5rem 0; border-bottom: 1px solid var(--border); }
  .tips-list li:last-child { border-bottom: none; }
  .tips-list li::before { content: '💡 '; }

  /* Other games */
  .other-games  { background: var(--bg-secondary); border-top: 1px solid var(--border); padding: 3rem 0; }
  .other-title  { font-size: 1.2rem; margin-bottom: 1rem; }
  .other-grid   { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px,1fr)); gap: .75rem; margin-bottom: 0; }
  .other-card   {
    display: flex; align-items: center; gap: .75rem;
    background: var(--bg-feature); border: 1px solid var(--border);
    border-radius: var(--radius-md); padding: .85rem 1rem;
    transition: all var(--transition); text-decoration: none; color: inherit;
  }
  .other-card:hover { border-color: var(--gold-border); transform: translateY(-1px); }
  .other-icon  { font-size: 1.5rem; }
  .other-icon :global(.gi-img) { width: 28px; height: 28px; object-fit: contain; display: block; }
  .other-name  { flex: 1; font-size: .875rem; font-weight: 600; color: var(--text-primary); }
  .other-arrow { color: var(--text-dim); transition: transform var(--transition); }
  .other-card:hover .other-arrow { transform: translateX(3px); color: var(--gold); }

  @media (max-width: 900px) {
    .game-layout { grid-template-columns: 1fr; }
    .game-sidebar { order: -1; }
  }
</style>

<script>
  // YouTube facade: the thumbnail + play button above is static HTML; the
  // real (heavy) player iframe is only created when the visitor clicks.
  document.querySelectorAll<HTMLElement>('.yt-lite').forEach(box => {
    box.querySelector('.yt-play')?.addEventListener('click', () => {
      const id    = box.dataset.ytId ?? '';
      const start = Number(box.dataset.ytStart ?? 0);
      const f = document.createElement('iframe');
      f.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1${start ? `&start=${start}` : ''}`;
      f.title = box.dataset.ytTitle ?? '';
      f.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      f.referrerPolicy = 'strict-origin-when-cross-origin';
      f.allowFullscreen = true;
      box.replaceChildren(f);
    }, { once: true });
  });
</script>
