---
<section class="pricing" id="pricing">
  <div class="container">
    <div class="section-header">
      <div class="section-tag">{copy.tag}</div>
      <h2 class="section-title">{copy.title}</h2>
      <p class="section-subtitle">{copy.subtitle}</p>
    </div>

    <div class="pricing-grid">

      <!-- Trial -->
      <div class="price-card price-card--trial">
        <div class="price-badge">{copy.trialBadge}</div>
        <div class="price-icon">🎉</div>
        <div class="price-amount">{copy.free}</div>
        <div class="price-period">{copy.trialPeriod}</div>
        <p class="price-desc">{copy.trialDesc}</p>
        <ul class="price-features">
          {features.map(f => (
            <li class={f.social ? 'feat-social' : ''}>{f.social ? f.text : `✓ ${f.text}`}</li>
          ))}
        </ul>
        <a href={href('/#download')} class="btn btn-primary price-btn">{copy.trialCta}</a>
        <p class="price-fine">{copy.trialFine}</p>
      </div>

      <!-- Free Forever -->
      <div class="price-card price-card--free">
        <div class="price-badge price-badge--free">{copy.freeBadge}</div>
        <div class="price-icon">♣</div>
        <div class="price-amount">{copy.free}</div>
        <div class="price-period">{copy.freePeriod}</div>
        <p class="price-desc">{copy.freeDesc}</p>
        <ul class="price-features">
          {copy.freeItems.map(t => <li>{t}</li>)}
          {copy.freeNoItems.map(t => <li class="feat-no">{t}</li>)}
        </ul>
        <a href={href('/games')} class="btn btn-secondary price-btn">{copy.freeCta}</a>
        <p class="price-fine">{copy.freeFine}</p>
      </div>

      <!-- Premium -->
      <div class="price-card price-card--premium">
        <div class="price-badge price-badge--premium">{copy.premiumBadge}</div>
        <div class="price-icon">👑</div>
        <div class="price-amount price-soon">{copy.premiumName}</div>
        <div class="price-period">{copy.premiumPeriod}</div>
        <p class="price-desc">{copy.premiumDesc}</p>
        <ul class="price-features">
          {features.map(f => (
            <li class={f.social ? 'feat-social' : ''}>{f.social ? f.text : `✓ ${f.text}`}</li>
          ))}
        </ul>
        <a href={href('/#download')} class="btn btn-primary price-btn">{copy.premiumCta}</a>
        <p class="price-fine">{copy.premiumFine}</p>
      </div>

    </div>

    <p class="pricing-note">
      <strong>{availCount} {copy.notePremium}</strong>: {availableGames.map(g => g.name).join(', ')} {copy.notePick}<br/>
      <strong>{csCount} {copy.noteSoon}</strong> {copy.noteEarly}
      &nbsp;<a href={href('/games')}>{copy.noteAll}</a>
    </p>
  </div>
</section>


<style>
  .pricing { background: var(--bg-secondary); border-top: 1px solid var(--border); }

  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem; margin-bottom: 2rem;
    align-items: start;
  }

  .price-card {
    background: var(--bg-card); border: 1px solid var(--border);
    border-radius: var(--radius-xl); padding: 2rem 1.75rem;
    position: relative; transition: box-shadow var(--transition);
  }
  .price-card--premium {
    border-color: var(--gold-border);
    background: linear-gradient(160deg, var(--bg-card) 0%, rgba(201,162,39,.05) 100%);
  }
  .price-card--premium:hover { box-shadow: var(--glow-gold); }

  .price-badge {
    display: inline-block; font-size: .65rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: .14em;
    padding: .25rem .7rem; border-radius: var(--radius-full); margin-bottom: 1rem;
    background: var(--bg-secondary); color: var(--text-dim); border: 1px solid var(--border);
  }
  .price-badge--free    { background: rgba(45,90,45,.25); color: #7acc7a; border-color: rgba(122,204,122,.3); }
  .price-badge--premium { background: var(--gold-subtle); color: var(--gold); border-color: var(--gold-border); }

  .price-icon   { font-size: 2.5rem; margin-bottom: .75rem; }
  .price-amount { font-family: 'Cinzel Variable',serif; font-size: 2.8rem; font-weight: 700; color: var(--gold-light); line-height: 1; }
  .price-soon   { font-size: 1.8rem; line-height: 1.2; }
  .price-period { font-size: .8rem; color: var(--text-dim); text-transform: uppercase; letter-spacing: .1em; margin: .25rem 0 1rem; }
  .price-yearly-note { font-size: .78rem; color: var(--text-muted); margin-top: -.75rem; margin-bottom: 1rem; }
  .price-desc   { font-size: .9rem; color: var(--text-muted); line-height: 1.6; margin-bottom: 1.25rem; }

  .price-features { list-style: none; padding: 0; margin-bottom: 1.5rem; display: flex; flex-direction: column; gap: .45rem; }
  .price-features li { font-size: .875rem; color: var(--text-secondary); }
  .feat-social { color: var(--gold-light) !important; }
  .feat-no { color: var(--text-dim) !important; }

  .price-btn    { width: 100%; justify-content: center; }
