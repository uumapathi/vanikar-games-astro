---
import { Image } from 'astro:assets';
import { getLocale, localizedHref } from '../i18n';
import appicon from '../assets/appicon.png';

const lang = getLocale(Astro.currentLocale);
const href = (p: string) => localizedHref(p, lang);
const copy = {
  en: {
    tag: '♠ Get the App', title: 'Deal Yourself In',
    subtitle: 'Free to download on iOS and Android. No account required to start playing — just pick a game and go.',
    iosLabel: 'Download on the', playLabel: 'Get it on',
    note: 'Free to play  ·  iOS 16+  ·  Android 9+  ·  In English — more languages coming soon',
  },
  es: {
    tag: '♠ Consigue la app', title: 'Reparte y juega',
    subtitle: 'Descarga gratis en iOS y Android. No necesitas cuenta para empezar a jugar — elige un juego y listo.',
    iosLabel: 'Descárgala en el', playLabel: 'Disponible en',
    note: 'Gratis  ·  iOS 16+  ·  Android 9+  ·  En inglés — más idiomas próximamente',
  },
  pt: {
    tag: '♠ Baixe o app', title: 'Entre na jogada',
    subtitle: 'Baixe grátis no iOS e no Android. Não precisa de conta para começar a jogar — é só escolher um jogo e partir para a mesa.',
    iosLabel: 'Baixar na', playLabel: 'Disponível no',
    note: 'Grátis para jogar  ·  iOS 16+  ·  Android 9+  ·  Em inglês — mais idiomas em breve',
  },
  fr: {
    tag: '♠ Obtenir l’app', title: 'À vous de jouer',
    subtitle: 'Téléchargement gratuit sur iOS et Android. Aucun compte requis pour commencer — choisissez un jeu et lancez-vous.',
    iosLabel: 'Télécharger dans l’', playLabel: 'Disponible sur',
    note: 'Gratuit  ·  iOS 16+  ·  Android 9+  ·  En anglais — d’autres langues arrivent bientôt',
  },
  de: {
    tag: '♠ App holen', title: 'Misch dich ein',
    subtitle: 'Kostenlos für iOS und Android. Kein Konto nötig, um loszulegen — wähl einfach ein Spiel und spiel los.',
    iosLabel: 'Laden im', playLabel: 'Jetzt bei',
    note: 'Kostenlos spielbar  ·  iOS 16+  ·  Android 9+  ·  Auf Englisch — weitere Sprachen folgen bald',
  },
  hi: {
    tag: '♠ ऐप पाएँ', title: 'खेल में शामिल हों',
    subtitle: 'iOS और Android पर मुफ़्त डाउनलोड करें। खेलना शुरू करने के लिए अकाउंट की ज़रूरत नहीं — बस एक गेम चुनें और खेलना शुरू करें।',
    iosLabel: 'डाउनलोड करें', playLabel: 'उपलब्ध है',
    note: 'खेलने के लिए मुफ़्त  ·  iOS 16+  ·  Android 9+  ·  अंग्रेज़ी में — और भाषाएँ जल्द आ रही हैं',
  },
}[lang];
---
<section class="download" id="download">
  <div class="container">
    <div class="section-header">
      <div class="section-tag">{copy.tag}</div>
      <Image
        src={appicon}
        alt="Card Games app icon"
        width={200}
        widths={[100, 200]}
        sizes="100px"
        quality={80}
        class="app-icon"
      />
      <h2 class="section-title">{copy.title}</h2>
      <p class="section-subtitle">{copy.subtitle}</p>
    </div>

    <div class="store-buttons">
      <button type="button" data-store="App Store" class="btn-store" aria-label="Download on the App Store">
        <img class="btn-store-appicon" src="/favicon-32.png" srcset="/favicon-32.png 1x, /icon-180.png 2x" width="36" height="36" alt="" />
        <div class="btn-store-text">
          <span class="btn-store-label">{copy.iosLabel}</span>
          <span class="btn-store-name">App Store</span>
        </div>
      </button>
      <button type="button" data-store="Google Play" class="btn-store" aria-label="Get it on Google Play">
        <img class="btn-store-appicon" src="/favicon-32.png" srcset="/favicon-32.png 1x, /icon-180.png 2x" width="36" height="36" alt="" />
        <div class="btn-store-text">
          <span class="btn-store-label">{copy.playLabel}</span>
          <span class="btn-store-name">Google Play</span>
        </div>
      </button>
    </div>

    <p class="download-note">{copy.note}</p>
  </div>
</section>

<style>
  .download {
    background:
      radial-gradient(ellipse at center, rgba(201,162,39,.06) 0%, transparent 65%),
      var(--bg-deep);
    text-align: center;
    border-top: 1px solid var(--border);
  }
  .download :global(.app-icon) {
    width: 100px; height: 100px; border-radius: 22px;
    margin: 1.25rem auto .5rem; display: block;
    box-shadow: 0 12px 32px rgba(0,0,0,.5), 0 0 24px rgba(201,162,39,.15);
  }
  .store-buttons {
    display: flex; justify-content: center; gap: 1rem;
    flex-wrap: wrap; margin-top: 2.5rem;
  }
  .btn-store-appicon { width: 36px; height: 36px; border-radius: 9px; flex-shrink: 0; }
  .download-note { margin-top: 1.5rem; font-size: .8rem; color: var(--text-dim); }

</style>
