---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { availableGames, comingSoonGames } from '../data/games';
import { getLocale, localizedHref } from '../i18n';

const shots = import.meta.glob<{ default: ImageMetadata }>('../assets/screenshots/app/*.png', { eager: true });
const homeShot  = shots['../assets/screenshots/app/home.png'].default;
const gamesShot = shots['../assets/screenshots/app/offline-game-selection.png'].default;

const avail = availableGames.length;
const cs    = comingSoonGames.length;

const lang = getLocale(Astro.currentLocale);
const href = (p: string) => localizedHref(p, lang);
const copy = {
  en: {
    tagline:    'Classic card tables, beautifully reimagined.',
    subtitle:   'Polished visuals, smart CPU opponents, and online tables for quick, confident play.',
    gamesLive:  'Games Live',
    comingSoon: 'Coming Soon',
    tables:     'Friends & Family Tables',
    download:   '⬇ Download Free',
    browse:     'Browse the Games',
    noAds:      '100% ad-free — always',
    pricing:    'Simple, honest pricing',
    voice:      'Voice Chat',
    statsLb:    'Stats & Leaderboards',
    tourn:      'Tournaments',
    clubs:      'Clubs',
    soon:       'Soon',
  },
  es: {
    tagline:    'Mesas de cartas clásicas, bellamente reinventadas.',
    subtitle:   'Gráficos pulidos, oponentes de IA inteligentes y mesas en línea para partidas rápidas y seguras.',
    gamesLive:  'Juegos activos',
    comingSoon: 'Próximamente',
    tables:     'Mesas con amigos y familia',
    download:   '⬇ Descarga gratis',
    browse:     'Explora los juegos',
    noAds:      '100% sin anuncios — siempre',
    pricing:    'Precios simples y honestos',
    voice:      'Chat de voz',
    statsLb:    'Estadísticas y clasificaciones',
    tourn:      'Torneos',
    clubs:      'Clubes',
    soon:       'Pronto',
  },
  pt: {
    tagline:    'Mesas de cartas clássicas, lindamente reinventadas.',
    subtitle:   'Visual caprichado, oponentes de IA inteligentes e mesas online para partidas rápidas e confiantes.',
    gamesLive:  'Jogos disponíveis',
    comingSoon: 'Em breve',
    tables:     'Mesas com amigos e família',
    download:   '⬇ Baixe grátis',
    browse:     'Explore os jogos',
    noAds:      '100% sem anúncios — sempre',
    pricing:    'Preços simples e honestos',
    voice:      'Chat de voz',
    statsLb:    'Estatísticas e rankings',
    tourn:      'Torneios',
    clubs:      'Clubes',
    soon:       'Em breve',
  },
  fr: {
    tagline:    'Les tables de cartes classiques, magnifiquement réinventées.',
    subtitle:   'Des graphismes soignés, des adversaires IA malins et des tables en ligne pour des parties rapides et sereines.',
    gamesLive:  'Jeux disponibles',
    comingSoon: 'Bientôt',
    tables:     'Tables entre amis et en famille',
    download:   '⬇ Télécharger gratuitement',
    browse:     'Parcourir les jeux',
    noAds:      '100 % sans publicité — toujours',
    pricing:    'Des prix simples et honnêtes',
    voice:      'Chat vocal',
    statsLb:    'Stats et classements',
    tourn:      'Tournois',
    clubs:      'Clubs',
    soon:       'Bientôt',
  },
  de: {
    tagline:    'Klassische Kartentische, wunderschön neu gedacht.',
    subtitle:   'Edle Optik, clevere CPU-Gegner und Online-Tische für schnelle, souveräne Partien.',
    gamesLive:  'Spiele live',
    comingSoon: 'Demnächst',
    tables:     'Tische mit Freunden & Familie',
    download:   '⬇ Kostenlos laden',
    browse:     'Spiele entdecken',
    noAds:      '100 % werbefrei — immer',
    pricing:    'Einfache, ehrliche Preise',
    voice:      'Sprachchat',
    statsLb:    'Statistiken & Ranglisten',
    tourn:      'Turniere',
    clubs:      'Clubs',
    soon:       'Bald',
  },
  hi: {
    tagline:    'क्लासिक ताश की मेज़ें, खूबसूरती से नए रूप में।',
    subtitle:   'शानदार ग्राफ़िक्स, स्मार्ट CPU प्रतिद्वंद्वी और तेज़, भरोसेमंद खेल के लिए ऑनलाइन टेबल।',
    gamesLive:  'लाइव गेम',
    comingSoon: 'जल्द आ रहा है',
    tables:     'दोस्तों और परिवार के साथ टेबल',
    download:   '⬇ मुफ़्त डाउनलोड करें',
    browse:     'गेम देखें',
    noAds:      '100% विज्ञापन-मुक्त — हमेशा',
    pricing:    'सरल, ईमानदार कीमतें',
    voice:      'वॉइस चैट',
    statsLb:    'आँकड़े और लीडरबोर्ड',
    tourn:      'टूर्नामेंट',
    clubs:      'क्लब',
    soon:       'जल्द',
  },
}[lang];
---
<section class="hero" id="home">
  <div class="hero-decorations" aria-hidden="true">
    <span class="hero-suit">♠</span>
    <span class="hero-suit">♥</span>
    <span class="hero-suit">♦</span>
    <span class="hero-suit">♣</span>
  </div>

  <div class="container">
    <div class="hero-grid">
      <div class="hero-content">
        <div class="hero-badge">
          <span>♛</span> Vanikar LLC
        </div>

        <h1 class="hero-title">Card Games</h1>

        <p class="hero-tagline">{copy.tagline}</p>

        <p class="hero-subtitle">{copy.subtitle}</p>

        <div class="hero-noads">
          <a class="noads-pill" href="#no-ads">🚫 {copy.noAds}</a>
          <a class="noads-pill" href="#pricing">♦ {copy.pricing}</a>
        </div>

        <div class="hero-stats">
          <a class="hero-stat hero-stat-link" href={href('/games#premium-group')}>
            <span class="hero-stat-value">{avail}</span>
            <span class="hero-stat-label">{copy.gamesLive}</span>
          </a>
          <a class="hero-stat hero-stat-link" href={href('/games#coming-soon-group')}>
            <span class="hero-stat-value">{cs}</span>
            <span class="hero-stat-label">{copy.comingSoon}</span>
          </a>
          <div class="hero-stat">
            <span class="hero-stat-value">24/7</span>
            <span class="hero-stat-label">{copy.tables}</span>
          </div>
        </div>

        <div class="hero-features">
          <a class="feat-chip" href="#voice-chat">🎙️ {copy.voice}</a>
          <a class="feat-chip" href="#leaderboards">📊 {copy.statsLb}</a>
          <a class="feat-chip" href="#features">🏆 {copy.tourn} <em>{copy.soon}</em></a>
          <a class="feat-chip" href="#features">♣ {copy.clubs} <em>{copy.soon}</em></a>
          <a class="feat-chip" href={href('/pricing#faq')}>❓ FAQ</a>
        </div>

        <div class="hero-actions">
          <a href="#download" class="btn btn-primary">{copy.download}</a>
          <a href={href('/games')} class="btn btn-secondary">{copy.browse}</a>
        </div>

        <div class="hero-platforms">
          <a class="platform-badge" href="/ios">iOS</a>
          <span>&middot;</span>
          <a class="platform-badge" href="/android">Android</a>
        </div>
      </div>

      <div class="hero-visual" aria-hidden="true">
        <div class="float-card float-card--1"><span>A</span>♠</div>
        <div class="float-card float-card--2"><span>K</span>♥</div>
        <div class="float-card float-card--3"><span>Q</span>♦</div>
        <div class="phone phone--back">
          <Image
            src={gamesShot}
            alt=""
            width={500}
            widths={[250, 500]}
            sizes="250px"
            quality={60}
            loading="eager"
            class="phone-img"
          />
        </div>
        <div class="phone phone--front">
          <Image
            src={homeShot}
            alt="Card Games app home screen"
            width={600}
            widths={[300, 600]}
            sizes="(max-width: 900px) 260px, 300px"
            quality={70}
            loading="eager"
            fetchpriority="high"
            class="phone-img"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: calc(100vh - var(--nav-height));
    display: flex; align-items: center;
    background:
      radial-gradient(ellipse at 50% 20%, rgba(201,162,39,.07) 0%, transparent 55%),
      linear-gradient(180deg, var(--bg-deep) 0%, var(--bg-primary) 100%);
    overflow: hidden; padding: 3rem 0 4rem;
  }
  .hero-decorations { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
  .hero-suit {
    position: absolute; font-size: clamp(4rem,10vw,9rem);
    opacity: .04; color: var(--gold); user-select: none;
    animation: hero-float 10s ease-in-out infinite;
  }
  .hero-suit:nth-child(1) { top:  8%; left:  4%; animation-delay: 0s;   }
  .hero-suit:nth-child(2) { top: 12%; right: 6%; animation-delay: 2.5s; }
  .hero-suit:nth-child(3) { bottom: 18%; left:  8%; animation-delay: 5s;}
  .hero-suit:nth-child(4) { bottom: 12%; right: 4%; animation-delay: 1.5s; }
  @keyframes hero-float {
    0%,100% { transform: translateY(0)     rotate(0deg); }
    33%      { transform: translateY(-18px) rotate(4deg); }
    66%      { transform: translateY(9px)   rotate(-3deg); }
  }

  .hero-grid {
    display: grid; grid-template-columns: minmax(0,1.1fr) minmax(0,.9fr);
    gap: 3rem; align-items: center;
  }
  .hero-content { position: relative; max-width: 620px; padding: 0 1.5rem; }

  .hero-badge {
    display: inline-flex; align-items: center; gap: .5rem;
    background: var(--gold-subtle); border: 1px solid var(--gold-border);
    border-radius: var(--radius-full); padding: .4rem 1.1rem;
    font-size: .78rem; font-weight: 700; letter-spacing: .18em;
    text-transform: uppercase; color: var(--gold); margin-bottom: 1.5rem;
  }
  .hero-title {
    font-size: clamp(3rem,7vw,5rem); font-weight: 900;
    letter-spacing: .06em; margin-bottom: 1rem;
    background: linear-gradient(135deg,#fff 10%,var(--gold-light) 50%,#fff 90%);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
  }
  .hero-tagline {
    font-size: clamp(1.1rem,2.5vw,1.45rem); color: var(--text-secondary);
    margin-bottom: .75rem; font-family: 'Inter',sans-serif;
  }
  .hero-subtitle {
    font-size: 1rem; color: var(--text-muted);
    max-width: 520px; margin: 0 0 2.25rem; line-height: 1.8;
  }
  .hero-stats {
    display: flex; gap: 1rem;
    margin-bottom: 1rem; flex-wrap: wrap;
  }
  .hero-features { display: flex; flex-wrap: wrap; gap: .5rem; margin-bottom: 2rem; }
  .feat-chip {
    display: inline-flex; align-items: center; gap: .4rem;
    background: var(--gold-subtle); border: 1px solid var(--gold-border);
    border-radius: var(--radius-full); padding: .32rem .85rem;
    font-size: .78rem; font-weight: 600; color: var(--text-secondary);
    white-space: nowrap; text-decoration: none;
    transition: all var(--transition);
  }
  .feat-chip:hover { border-color: var(--gold); color: var(--gold-light); transform: translateY(-1px); }
  .feat-chip em {
    font-style: normal; font-size: .58rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: .06em;
    background: rgba(120,80,200,.18); color: #b490f5;
    border: 1px solid rgba(180,144,245,.3);
    border-radius: var(--radius-full); padding: .06rem .4rem;
  }
  .hero-stat {
    display: flex; flex-direction: column; align-items: center;
    background: var(--gold-subtle); border: 1px solid var(--gold-border);
    border-radius: var(--radius-md); padding: .75rem 1.5rem; min-width: 96px;
  }
  .hero-stat-link {
    text-decoration: none;
    transition: transform var(--transition), border-color var(--transition), box-shadow var(--transition);
  }
  .hero-stat-link:hover {
    transform: translateY(-3px); border-color: var(--gold);
    box-shadow: 0 4px 14px rgba(201,162,39,.25);
  }
  .hero-stat-value {
    font-family: 'Cinzel',serif; font-size: 1.6rem; font-weight: 700;
    color: var(--gold-light); line-height: 1;
  }
  .hero-stat-label {
    font-size: .7rem; color: var(--text-muted);
    text-transform: uppercase; letter-spacing: .12em; margin-top: .3rem;
  }
  .hero-actions { display: flex; gap: 1rem; flex-wrap: wrap; margin-bottom: 1.75rem; }
  .hero-platforms {
    display: flex; align-items: center;
    gap: .5rem; font-size: .78rem; color: var(--text-dim);
  }
  .platform-badge {
    background: var(--bg-card); border: 1px solid var(--border);
    border-radius: var(--radius-sm); padding: .2rem .6rem; font-weight: 500;
    color: inherit; text-decoration: none; transition: all var(--transition);
  }
  a.platform-badge:hover { border-color: var(--gold-border); color: var(--gold-light); }
  .hero-noads { display: flex; flex-wrap: wrap; gap: .5rem; margin: -1rem 0 1.75rem; }
  .noads-pill {
    display: inline-block;
    background: var(--gold-subtle); border: 1px solid var(--gold-border);
    border-radius: var(--radius-full); padding: .35rem 1rem;
    font-size: .85rem; font-weight: 700; color: var(--gold-light);
    letter-spacing: .04em; text-decoration: none;
    transition: all var(--transition);
  }
  .noads-pill:hover { background: var(--gold); color: var(--bg-deep); }

  /* Phone composition */
  .hero-visual {
    position: relative; display: flex; justify-content: center;
    min-height: 560px; align-items: center;
  }
  .phone {
    border-radius: 1.9rem; overflow: hidden;
    border: 3px solid #2e2e2e; background: #000;
    box-shadow: 0 24px 60px rgba(0,0,0,.55), 0 0 40px rgba(201,162,39,.12);
  }
  .phone :global(.phone-img) { display: block; width: 100%; height: auto; }
  .phone--front {
    position: relative; width: min(300px, 70%); z-index: 2;
    transform: rotate(-5deg);
    animation: phone-bob 7s ease-in-out infinite;
  }
  .phone--back {
    position: absolute; width: min(250px, 55%); z-index: 1;
    right: 2%; top: 6%;
    transform: rotate(7deg) scale(.96);
    opacity: .75; filter: brightness(.8);
    animation: phone-bob 7s ease-in-out infinite reverse;
  }
  @keyframes phone-bob {
    0%,100% { translate: 0 0; }
    50%     { translate: 0 -12px; }
  }

  /* Floating cards */
  .float-card {
    position: absolute; z-index: 3;
    width: 58px; height: 80px; border-radius: 8px;
    background: linear-gradient(160deg, #fdfdf6 0%, #efeadb 100%);
    border: 1px solid rgba(0,0,0,.25);
    box-shadow: 0 10px 26px rgba(0,0,0,.45);
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    font-size: 1.5rem; line-height: 1; font-weight: 700;
    animation: card-drift 9s ease-in-out infinite;
  }
  .float-card span { font-family: 'Cinzel',serif; font-size: 1.05rem; }
  .float-card--1 { color: #16161a; left: 4%;  top: 8%;   rotate: -14deg; animation-delay: 0s; }
  .float-card--2 { color: #a3222c; right: 0%; bottom: 12%; rotate: 12deg;  animation-delay: 3s; }
  .float-card--3 { color: #a3222c; left: 10%; bottom: 4%;  rotate: -7deg;  animation-delay: 6s; }
  @keyframes card-drift {
    0%,100% { translate: 0 0; }
    33%     { translate: -6px -14px; }
    66%     { translate: 5px 8px; }
  }

  @media (max-width: 900px) {
    .hero { padding: 1.25rem 0 3rem; }
    .hero-grid { grid-template-columns: 1fr; gap: 2.5rem; }
    .hero-content { text-align: center; margin: 0 auto; }
    .hero-subtitle { margin-left: auto; margin-right: auto; }
    .hero-noads, .hero-stats, .hero-features, .hero-actions, .hero-platforms { justify-content: center; }
    .hero-visual { min-height: 0; }
    .phone--front { width: min(260px, 78%); }
    .phone--back  { display: none; }
    .float-card   { display: none; }
  }
  @media (max-width: 767px) {
    /* compress the hero so tiles, chips, and both CTAs fit the first viewport */
    .hero-badge    { margin-bottom: .9rem; padding: .3rem .9rem; }
    .hero-title    { font-size: 2.4rem; margin-bottom: .6rem; }
    .hero-tagline  { font-size: 1rem; margin-bottom: .5rem; }
    .hero-subtitle { font-size: .88rem; margin-bottom: 1.4rem; line-height: 1.6; }
    .hero-noads    { margin: -.4rem 0 1.2rem; }
    .hero-stats    { gap: .6rem; margin-bottom: .75rem; }
    .hero-stat     { padding: .5rem 1rem; min-width: 80px; }
    .hero-stat-value { font-size: 1.25rem; }
    .hero-features { margin-bottom: 1.4rem; }
    /* keep both CTAs on one row so they stay in the first viewport */
    .hero-actions { gap: .6rem; margin-bottom: 1.25rem; }
    .hero-actions .btn { padding: .8rem 1.1rem; font-size: .85rem; }
  }
</style>
