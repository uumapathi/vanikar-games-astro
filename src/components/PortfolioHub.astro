/* Placeholder glyphs for titles that have no artwork yet. Drawn rather than
   sourced so they share one weight and one palette, and so a missing asset
   never ships as a broken tile. */
const G = (body: string) =>
  `<svg viewBox="0 0 64 64" fill="none" stroke="#5cc9c3" stroke-width="2.4"
        stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${body}</svg>`;

const upcoming = [
  {
    name: L.chessName, desc: L.chessDesc,
    glyph: G(`<path d="M32 12v8M28 16h8"/><circle cx="32" cy="25" r="5"/>
              <path d="M20 50c0-11 5-15 12-15s12 4 12 15z"/>
              <rect x="17" y="50" width="30" height="6" rx="3"/>`),
  },
  {
    name: L.boardName, desc: L.boardDesc,
    glyph: G(`<rect x="12" y="12" width="40" height="40" rx="6"/>
              <path d="M32 12v40M12 32h40"/>
              <rect x="12" y="12" width="20" height="20" rx="6" fill="#5cc9c3" fill-opacity=".18" stroke="none"/>
              <rect x="32" y="32" width="20" height="20" rx="6" fill="#5cc9c3" fill-opacity=".18" stroke="none"/>`),
  },
  {
    name: L.stratName, desc: L.stratDesc,
    glyph: G(`<path d="M32 10l11 6.5v13L32 36l-11-6.5v-13z"/>
              <path d="M20 36l10 6v11l-10-6z"/><path d="M44 36l-10 6v11l10-6z"/>`),
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: L.h1,
  description: L.description,
  inLanguage: lang,
  url: new URL(href('/'), Astro.site).href,
  publisher: {
    '@type': 'Organization',
    name: 'Vanikar LLC',
    url: 'https://vanikar.com',
    logo: new URL('/icon-180.png', Astro.site).href,
  },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: 1,
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: L.cardName,
        url: new URL(href('/cardgames'), Astro.site).href,
      },
    ],
  },
};
---
<BaseLayout title={L.title} description={L.description} image="/og/vanikar.png">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <section class="portfolio">
    <div class="container">
      <div class="section-header">
        <h1 class="portfolio-title">{L.h1}</h1>
        <p class="section-subtitle">{L.lead}</p>
      </div>

      <div class="product-grid">
        <a class="product-card" href={href('/cardgames')}>
          <Image
            src={appicon}
            alt={L.cardName}
            width={192}
            widths={[96, 192]}
            sizes="96px"
            quality={80}
            class="product-icon"
          />
          <div class="product-body">
            <span class="product-badge">{L.live}</span>
            <h2 class="product-name">{L.cardName}</h2>
            <p class="product-desc">{L.cardDesc}</p>
            <p class="product-stat">{L.cardStat(avail, total)}</p>
            <span class="product-cta">{L.cardCta}</span>
          </div>
        </a>

        {/* Titles in development. No art exists yet, so each uses a drawn
            glyph in the same 96px tile the shipped icon occupies — a real
            placeholder rather than a stretched stand-in. Not links: there is
            nothing to link to. */}
        {upcoming.map(u => (
          <div class="product-card product-card--soon">
            <span class="product-icon product-glyph" aria-hidden="true" set:html={u.glyph} />
            <div class="product-body">
              <span class="product-badge product-badge--soon">{L.soon}</span>
              <h2 class="product-name">{u.name}</h2>
              <p class="product-desc">{u.desc}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="more-panel">
        <h2 class="more-title">{L.moreTitle}</h2>
        <p class="more-body">{L.moreBody}</p>
        <a class="more-link" href="https://vanikar.com" target="_blank" rel="noopener">{L.company}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .portfolio {
    background:
      radial-gradient(ellipse at 50% 0%, rgba(201,162,39,.08) 0%, transparent 60%),
      var(--bg-deep);
    min-height: 70vh;
  }
  .portfolio-title {
    font-family: 'Cinzel Variable', Georgia, serif;
    font-size: clamp(1.9rem, 4.4vw, 2.9rem);
    color: var(--gold-light);
    margin: 0 0 .75rem;
  }
  .product-grid {
    display: grid; gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 330px), 1fr));
    max-width: 920px; margin: 0 auto;
  }
  /* Shipped titles are links; the rest are inert, so they lose the hover
     affordance and sit back a step in contrast. */
  .product-card--soon { cursor: default; opacity: .82; }
  .product-card--soon:hover { border-color: var(--border); transform: none; }
  .product-glyph {
    display: grid; place-items: center;
    background: linear-gradient(180deg, rgba(63,181,175,.14), rgba(20,114,126,.04)), #0b170c;
    border: 1px solid rgba(92,201,195,.22);
  }
  .product-glyph :global(svg) { width: 58%; height: 58%; }
  .product-badge--soon {
    color: var(--text-muted); border-color: var(--border);
  }
  .product-card {
    display: flex; gap: 1.25rem; align-items: flex-start;
    padding: 1.5rem; text-decoration: none;
    background: var(--bg-card); border: 1px solid var(--border);
    border-radius: 16px; transition: border-color var(--transition), transform var(--transition);
  }
  .product-card:hover { border-color: var(--gold); transform: translateY(-2px); }
  .product-card :global(.product-icon) {
    width: 96px; height: 96px; border-radius: 20px; flex-shrink: 0;
    box-shadow: 0 8px 24px rgba(0,0,0,.45);
  }
  .product-body { flex: 1; min-width: 0; }
  .product-badge {
    display: inline-block; font-size: .7rem; letter-spacing: .08em; text-transform: uppercase;
    color: var(--gold-light); border: 1px solid var(--gold-border);
    border-radius: 999px; padding: .15rem .6rem; margin-bottom: .5rem;
  }
  .product-name { font-size: 1.25rem; color: var(--text-primary); margin: 0 0 .4rem; }
  .product-desc { font-size: .9rem; color: var(--text-secondary); margin: 0 0 .6rem; }
  .product-stat { font-size: .8rem; color: var(--text-dim); margin: 0 0 .75rem; }
  .product-cta { font-size: .9rem; color: var(--gold-light); font-weight: 600; }

  .more-panel {
    max-width: 720px; margin: 3rem auto 0; padding: 1.5rem;
    border: 1px dashed var(--border); border-radius: 16px; text-align: center;
  }
  .more-title { font-size: 1.05rem; color: var(--text-primary); margin: 0 0 .5rem; }
  .more-body { font-size: .9rem; color: var(--text-secondary); margin: 0 0 .75rem; }
  .more-link { font-size: .875rem; color: var(--gold-light); text-decoration: none; }
  .more-link:hover { text-decoration: underline; }

  @media (max-width: 520px) {
    .product-card { flex-direction: column; }
    .product-card :global(.product-icon) { width: 80px; height: 80px; }
  }
</style>
