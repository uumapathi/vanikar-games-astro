---
import VanikarLockup from './VanikarLockup.astro';
import { getLocale, useTranslations, localizedHref, rootHref, unlocalizePath, localizePath, isTranslated, usesHubChrome, PRODUCT_BASE, LOCALES, LOCALE_LABELS } from '../i18n';
import { WEB_APP_URL } from '../data/stores';

const locale = getLocale(Astro.currentLocale);
const t      = useTranslations(locale);
const href   = (p: string) => localizedHref(p, locale);

const basePath = unlocalizePath(Astro.url.pathname);

/* The domain root is a portfolio hub shared by every product, so it must not
   carry Card Games' navigation. Only the company-wide pages and the language
   picker belong there. The legal pages are Vanikar LLC's and cover every
   product, so they get the same treatment. Everywhere else is inside a
   product, where "Home" means the hub and a separate link returns to the
   product's own home. */
const isHub       = usesHubChrome(basePath);
/* Hub chrome is not the same as being the hub: About, Privacy and Terms wear
   it but need a way back, which on the hub itself would link to the page you
   are already on. */
const isHubRoot   = basePath === '/';
const hubHref     = rootHref('/', locale);
const productHome = href('/');

const isProductHome = basePath === PRODUCT_BASE || basePath === `${PRODUCT_BASE}/`;
const isGames   = basePath.startsWith(`${PRODUCT_BASE}/availablegames`);
const isPricing = basePath.startsWith(`${PRODUCT_BASE}/pricing`);
const isPrivacy = basePath.startsWith('/privacy');
const isTerms   = basePath.startsWith('/terms');

/* Language switcher: same page when translated, locale home otherwise */
const switchTarget = (l: (typeof LOCALES)[number]) =>
  isTranslated(basePath) ? localizePath(basePath, l) : localizePath('/', l);
---

<nav class="navbar">
  <div class="navbar-inner">
    <a href={isHub ? hubHref : productHome} class="navbar-brand">
      {isHub
        /* Hub pages carry the full logo — framed mark with GAMES inside — not
           the Card Games app icon. GAMES is only 7.5% of the artwork's width,
           so the lockup needs this much room to read at all, which is what
           sets the taller bar on these pages. */
        ? <span class="brand-lockup"><VanikarLockup /></span>
        : <img class="brand-icon" src="/favicon-32.png" srcset="/favicon-32.png 1x, /icon-180.png 2x" width="28" height="28" alt="" />}
      <span class:list={['brand-name', { 'metal-teal': isHub }]}>{isHub ? 'VANIKAR GAMES' : 'CARD GAMES'}</span>
    </a>

    <div class="navbar-nav">
      {!isHub && (
        <Fragment>
          <a href={hubHref}            class="nav-link">{t('nav.home')}</a>
          <a href={productHome}        class:list={['nav-link', { active: isProductHome }]}>{t('nav.productHome')}</a>
          <a href={href('/games')}     class:list={['nav-link', { active: isGames }]}>{t('nav.games')}</a>
          <a href={href('/#social')}   class="nav-link">{t('nav.community')}</a>
          <a href={href('/pricing')}   class:list={['nav-link', { active: isPricing }]}>{t('nav.pricing')}</a>
        </Fragment>
      )}
      {isHub && !isHubRoot && <a href={hubHref} class="nav-link">{t('nav.home')}</a>}
      <a href={href('/privacy')}   class:list={['nav-link', { active: isPrivacy }]}>{t('nav.privacy')}</a>
      <a href={href('/terms')}     class:list={['nav-link', { active: isTerms }]}>{t('nav.terms')}</a>
      {/* Two ways in: the browser version is a real link and plays at once;
          the store button still has to work out which store to send you to. */}
      {!isHub && <a href={WEB_APP_URL} class="nav-link nav-cta nav-cta--web">{t('nav.playWeb')}</a>}
      {!isHub && <button type="button" data-store="App Store / Google Play" class="nav-link nav-cta">{t('nav.getApp')}</button>}
      <div class="lang-dd" id="lang-dd">
        <button class="lang-dd-btn" id="lang-dd-btn" aria-haspopup="true" aria-expanded="false" aria-label="Language">
          <svg class="lang-dd-globe" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/>
          </svg>
          <span lang={locale}>{LOCALE_LABELS[locale]}</span>
          <span class="lang-dd-caret" aria-hidden="true">▾</span>
        </button>
        <ul class="lang-dd-menu" id="lang-dd-menu" hidden>
          {LOCALES.map(l => (
            <li>
              <a href={switchTarget(l)}
                 class:list={['lang-dd-item', { active: l === locale }]}
                 aria-current={l === locale ? 'true' : undefined}
                 lang={l}>
                {LOCALE_LABELS[l]}
                {l === locale && <span class="lang-dd-check" aria-hidden="true">✓</span>}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <button class="navbar-toggle" id="nav-toggle" aria-label="Toggle navigation" aria-expanded="false">
      ☰
    </button>
  </div>

  <div class="navbar-mobile" id="nav-mobile" aria-hidden="true">
    {!isHub && (
      <Fragment>
        <a href={hubHref}>{t('nav.home')}</a>
        <a href={productHome}>{t('nav.productHome')}</a>
        <a href={href('/games')}>{t('nav.games')}</a>
        <a href={href('/#social')}>{t('nav.community')}</a>
        <a href={href('/pricing')}>{t('nav.pricing')}</a>
      </Fragment>
    )}
    {isHub && !isHubRoot && <a href={hubHref}>{t('nav.home')}</a>}
    <a href={href('/privacy')}>{t('footer.privacy')}</a>
    <a href={href('/terms')}>{t('footer.terms')}</a>
    <div class="lang-mobile" role="group" aria-label="Language">
      {LOCALES.map(l => (
        <a href={switchTarget(l)}
           class:list={['lang-mobile-item', { active: l === locale }]}
           lang={l}>{LOCALE_LABELS[l]}</a>
      ))}
    </div>
    {!isHub && <a href={WEB_APP_URL} class="nav-cta nav-cta--web" style="text-align:center;margin-top:.5rem;width:100%">{t('nav.playWeb')}</a>}
    {!isHub && <button type="button" data-store="App Store / Google Play" class="nav-cta" style="text-align:center;margin-top:.5rem;width:100%">{t('nav.getApp')}</button>}
  </div>
</nav>

<script>
  const toggle = document.getElementById('nav-toggle') as HTMLButtonElement;
  const mobile = document.getElementById('nav-mobile') as HTMLElement;

  /* Language dropdown */
  const langDd   = document.getElementById('lang-dd') as HTMLElement;
  const langBtn  = document.getElementById('lang-dd-btn') as HTMLButtonElement;
  const langMenu = document.getElementById('lang-dd-menu') as HTMLElement;

  function closeLangMenu() {
    langMenu.hidden = true;
    langBtn.setAttribute('aria-expanded', 'false');
  }
  langBtn?.addEventListener('click', () => {
    const open = langMenu.hidden;
    langMenu.hidden = !open;
    langBtn.setAttribute('aria-expanded', String(open));
  });
  document.addEventListener('click', e => {
    if (!langMenu.hidden && !langDd.contains(e.target as Node)) closeLangMenu();
  });
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape' && !langMenu.hidden) { closeLangMenu(); langBtn.focus(); }
  });

  toggle?.addEventListener('click', () => {
    const open = mobile.classList.toggle('open');
    toggle.textContent  = open ? '✕' : '☰';
    toggle.setAttribute('aria-expanded', String(open));
    mobile.setAttribute('aria-hidden',   String(!open));
  });

  mobile?.querySelectorAll('a').forEach(a =>
    a.addEventListener('click', () => {
      mobile.classList.remove('open');
      toggle.textContent = '☰';
      toggle.setAttribute('aria-expanded', 'false');
      mobile.setAttribute('aria-hidden', 'true');
    })
  );
</script>

<style>
  .navbar {
    position: fixed; top: 0; left: 0; right: 0;
    height: var(--nav-height);
    background: rgba(8,14,8,.94);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--border-gold, rgba(201,162,39,.22));
    z-index: 1000;
  }
  .navbar-inner {
    display: flex; align-items: center; justify-content: space-between;
    height: var(--nav-height);
    max-width: var(--max-width); margin: 0 auto; padding: 0 1.5rem;
  }
  .navbar-brand {
    display: flex; align-items: center; gap: .5rem;
    font-family: 'Cinzel Variable', serif; font-weight: 700; font-size: 1.15rem;
    letter-spacing: .12em; color: var(--gold-light);
  }
  .brand-icon { width: 28px; height: 28px; border-radius: 7px; display: block; }

  /* Hub header logo. Sized to match the mark on vanikar.com so the two
     properties read as siblings: 64px overall (48px on phones). The artwork
     width is all this sets — VanikarLockup scales its frame, padding and
     wordmark from it. The parent site frames its logo with a teal-to-gold
     gradient border, which is the same idea as this ring. */
  .brand-lockup { display: block; --lockup-w: 84px; }
  /* A 64px logo needs slightly more room than the 68px default bar allows.
     --nav-height is set on the body, not here, because .main-content padding
     reads the same variable and would otherwise sit under the bar. */
  :global(body.is-hub) { --nav-height: 88px; }
  /* Hub bar: logo hard left, wordmark in the true centre, links right. The
     three columns are a grid rather than absolute positioning, so the centred
     wordmark can never overlap the links the way an absolute one did.
     display:contents lets the logo and the wordmark sit in different columns
     while staying inside one anchor — two links to the same page would just
     be announced twice. */
  :global(body.is-hub) .navbar-inner {
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center;
  }
  :global(body.is-hub) .navbar-brand  { display: contents; }
  :global(body.is-hub) .brand-lockup  { grid-column: 1; justify-self: start; }
  :global(body.is-hub) .brand-name    { grid-column: 2; justify-self: center; }
  :global(body.is-hub) .navbar-nav    { grid-column: 3; justify-self: end; }
  :global(body.is-hub) .navbar-toggle { grid-column: 3; justify-self: end; }

  /* The wordmark's metallic finish lives in global.css as .metal-teal, shared
     with the footer — the two had drifted to different colours while each kept
     a copy. Only the face belongs to the header. */
  .brand-name { font-family: 'Cinzel Variable', serif; }
  @media (max-width: 720px) {
    .brand-lockup { --lockup-w: 59px; }
    :global(body.is-hub) { --nav-height: 72px; }
    .navbar-brand { font-size: .95rem; letter-spacing: .08em; }
  }
  .navbar-nav { display: flex; align-items: center; gap: .15rem; }
  .nav-link {
    padding: .45rem .85rem; border-radius: var(--radius-sm);
    color: var(--text-secondary); font-size: .875rem; font-weight: 500;
    transition: color var(--transition), background var(--transition);
  }
  .nav-link:hover, .nav-link.active {
    color: var(--text-primary); background: var(--gold-subtle);
  }
  .nav-cta {
    background: var(--gold); color: var(--bg-deep) !important;
    font-weight: 700; border-radius: var(--radius-full);
    padding: .5rem 1.2rem; margin-left: .5rem;
    /* rendered as <button> until real store URLs exist */
    border: none; font-family: inherit; font-size: inherit; cursor: pointer;
    /* A pill broken over two lines reads as a bug; when the bar is tight the
       plain links are the ones that wrap. */
    white-space: nowrap;
  }
  .nav-cta:hover { background: var(--gold-light); }
  /* The browser link is the outlined twin of the filled store button, so the
     pair reads as two routes to the same app rather than two competing CTAs. */
  .nav-cta--web {
    background: var(--gold-subtle); color: var(--gold-light) !important;
    border: 1.5px solid var(--gold-border); padding: calc(.5rem - 1.5px) 1.2rem;
  }
  .nav-cta--web:hover { background: rgba(201,162,39,.16); border-color: var(--gold); }
  .lang-dd { position: relative; margin-left: .6rem; }
  .lang-dd-btn {
    display: flex; align-items: center; gap: .5rem;
    padding: .5rem 1rem;
    background: var(--gold-subtle); border: 1.5px solid var(--gold-border);
    border-radius: var(--radius-full); cursor: pointer;
    color: var(--gold-light); font-size: .875rem; font-weight: 700;
    font-family: inherit; transition: all var(--transition);
  }
  .lang-dd-btn:hover, .lang-dd-btn[aria-expanded="true"] {
    color: var(--gold-light); border-color: var(--gold);
    background: rgba(201,162,39,.16);
    box-shadow: 0 2px 12px rgba(201,162,39,.25);
  }
  .lang-dd-globe { width: 17px; height: 17px; flex-shrink: 0; color: var(--gold); }
  .lang-dd-caret { font-size: .7rem; color: var(--gold); }
  .lang-dd-menu {
    position: absolute; top: calc(100% + .5rem); right: 0;
    min-width: 170px; margin: 0; padding: .4rem; list-style: none;
    background: rgba(10,18,10,.98); border: 1px solid var(--border);
    border-radius: var(--radius-md);
    box-shadow: 0 12px 34px rgba(0,0,0,.5);
    backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
    z-index: 1001;
  }
  .lang-dd-menu[hidden] { display: none; }
  .lang-dd-item {
    display: flex; align-items: center; justify-content: space-between;
    gap: 1rem; padding: .5rem .75rem; border-radius: var(--radius-sm);
    font-size: .875rem; color: var(--text-secondary);
    transition: color var(--transition), background var(--transition);
  }
  .lang-dd-item:hover  { color: var(--text-primary); background: var(--gold-subtle); }
  .lang-dd-item.active { color: var(--gold); }
  .lang-dd-check { font-size: .8rem; }

  .lang-mobile {
    display: flex; flex-wrap: wrap; gap: .35rem;
    margin: .5rem 1rem 0;
  }
  .lang-mobile-item {
    padding: .4rem .85rem; border: 1px solid var(--border);
    border-radius: var(--radius-full); font-size: .85rem;
    color: var(--text-secondary); transition: all var(--transition);
  }
  .lang-mobile-item:hover  { color: var(--text-primary); background: var(--gold-subtle); }
  .lang-mobile-item.active { color: var(--gold); border-color: var(--gold-border); background: var(--gold-subtle); }
  .navbar-toggle {
    display: none; background: none; border: none;
    color: var(--text-primary); font-size: 1.4rem; padding: .5rem; line-height: 1;
  }
  .navbar-mobile {
    display: none; position: fixed; top: var(--nav-height);
    left: 0; right: 0; background: rgba(8,14,8,.98);
    backdrop-filter: blur(14px); border-bottom: 1px solid var(--border);
    padding: 1rem; flex-direction: column; gap: .25rem; z-index: 999;
  }
  .navbar-mobile.open { display: flex; }
  .navbar-mobile a {
    padding: .75rem 1rem; border-radius: var(--radius-sm);
    color: var(--text-secondary); transition: color var(--transition), background var(--transition);
  }
  .navbar-mobile a:hover { color: var(--text-primary); background: var(--gold-subtle); }
  @media (max-width: 767px) {
    .navbar-nav  { display: none; }
    .navbar-toggle { display: flex; align-items: center; }
  }
</style>
