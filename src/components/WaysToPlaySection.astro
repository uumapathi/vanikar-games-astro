const ways = copy.ways;
---
<section class="ways" aria-label={copy.ariaLabel}>
  <div class="container">
    <div class="ways-header">
      <span class="ways-tag">{copy.tag}</span>
    </div>
    <div class="ways-grid">
      {ways.map(w => (
        <a class="way-link" href={href(w.href)}>
          <span class="way-icon">{w.icon}</span>
          <span class="way-text">
            <span class="way-title">
              {w.title}
              {w.soon && <span class="way-soon">{copy.soonLabel}</span>}
            </span>
            <span class="way-desc">{w.desc}</span>
          </span>
          <span class="way-arrow">›</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .ways {
    background: var(--bg-secondary);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: 2.25rem 0;
  }
  .ways-header { text-align: center; margin-bottom: 1.5rem; }
  .ways-tag {
    font-size: .8rem; font-weight: 700; letter-spacing: .18em;
    text-transform: uppercase; color: var(--gold);
  }
  .ways-grid {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: .9rem;
  }
  .way-link {
    display: flex; align-items: center; gap: .9rem;
    background: var(--bg-feature); border: 1px solid var(--gold-border);
    border-radius: var(--radius-lg); padding: 1rem 1.15rem;
    text-decoration: none;
    transition: all var(--transition);
  }
  .way-link:hover {
    border-color: var(--gold); background: var(--bg-card-elevated);
    transform: translateY(-3px);
    box-shadow: var(--shadow-md), 0 4px 18px rgba(201,162,39,.22);
  }
  .way-icon {
    flex-shrink: 0; width: 42px; height: 42px;
    display: flex; align-items: center; justify-content: center;
    background: var(--gold-subtle); border: 1px solid var(--gold-border);
    border-radius: var(--radius-md);
    font-size: 1.15rem; line-height: 1;
  }
  .way-text  { display: flex; flex-direction: column; min-width: 0; }
  .way-title {
    font-size: .92rem; font-weight: 700; color: var(--text-primary);
    line-height: 1.3;
  }
  .way-desc { font-size: .75rem; color: var(--text-muted); margin-top: .15rem; }
  .way-soon {
    display: inline-block; margin-left: .4rem; vertical-align: middle;
    padding: .1rem .5rem; border-radius: var(--radius-full);
    font-size: .58rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase;
    color: #b490f5; border: 1px solid rgba(180,144,245,.35);
    background: rgba(120,80,200,.12);
  }
  .way-arrow {
    margin-left: auto; color: var(--text-dim); font-size: 1.3rem;
    transition: transform var(--transition), color var(--transition);
  }
  .way-link:hover .way-arrow { transform: translateX(4px); color: var(--gold); }

  @media (max-width: 900px) { .ways-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .ways-grid { grid-template-columns: 1fr; } }
</style>
