---
/**
 * One feature hub page (/online-card-games, /es/online-card-games, …).
 * Copy comes from src/data/hubs/<locale>.ts; the locale is read from the URL.
 */
import BaseLayout     from '../layouts/BaseLayout.astro';
import FeatureLanding from './FeatureLanding.astro';
import Breadcrumb     from './Breadcrumb.astro';
import { hubCopy, type HubSlug } from '../data/hubs';
import { getLocale, localizedHref } from '../i18n';

interface Props { slug: HubSlug }
const { slug } = Astro.props;

const lang = getLocale(Astro.currentLocale);
const href = (p: string) => localizedHref(p, lang);
const C    = hubCopy(slug, lang);
const home = { en: 'Home', es: 'Inicio', pt: 'Início', fr: 'Accueil', de: 'Startseite', hi: 'होम', it: 'Home', ja: 'ホーム' }[lang];
const pageUrl = `https://vanikar.games${href(`/${slug}`)}`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: home,    item: `https://vanikar.games${href('/')}` },
      { '@type': 'ListItem', position: 2, name: C.crumb, item: pageUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: C.faqs.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---
<BaseLayout title={C.title} description={C.description}>
  <Fragment slot="head">
    {jsonLd.map(schema => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </Fragment>

  <div class="hub-crumbs">
    <div class="container">
      <Breadcrumb items={[{ name: home, href: href('/') }, { name: C.crumb }]} />
    </div>
  </div>

  <FeatureLanding
    h1={C.h1}
    intro={C.intro}
    sections={C.sections}
    faqs={C.faqs}
    gamesHeading={C.gamesHeading}
    gamesSub={C.gamesSub}
  />
</BaseLayout>

<style>
  .hub-crumbs { background: var(--bg-deep); padding: .75rem 0 0; }
</style>
