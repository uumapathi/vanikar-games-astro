---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { availableGames, comingSoonGames } from '../data/games';
import { localizeGame } from '../data/games.i18n';
import { getLocale, localizedHref } from '../i18n';
import { launchCopy } from '../data/launch';

interface Section {
  heading: string;
  body:    string;
  /** Feature not yet live — renders a Coming Soon badge next to the heading */
  soon?:   boolean;
}

interface Faq {
  q: string;
  a: string;
}

interface Props {
  /** H1 of the page */
  h1:        string;
  /** Short intro paragraph under the H1 (should contain the primary keyword naturally) */
  intro:     string;
  /** Explanatory sections unique to this feature */
  sections:  Section[];
  /** FAQ entries (also emitted as FAQPage JSON-LD by the page) */
  faqs:      Faq[];
  /** Heading above the games grid */
  gamesHeading: string;
  /** Line under the games grid heading */
  gamesSub:  string;
}

const { h1, intro, sections, faqs, gamesHeading, gamesSub } = Astro.props;

const lang  = getLocale(Astro.currentLocale);
const href  = (p: string) => localizedHref(p, lang);
const LN    = launchCopy(lang);
const avail = availableGames.map(g => localizeGame(g, lang));

/* Template chrome shared by every hub page */
const C = {
  en: { browse: 'Browse All Games', soon: 'Coming Soon',
        more: (names: string, k: number) => `More on the way: ${names} and ${k} others are in development.`,
        seeAll: 'See all coming-soon games →', faq: 'Frequently Asked Questions',
        ctaH: 'Ready to deal in?',
        ctaP: 'Download the Vanikar Card Games app free on iOS or Android — every game unlocked for 2 weeks, no credit card required.',
        pricing: 'View Pricing' },
  es: { browse: 'Ver todos los juegos', soon: 'Próximamente',
        more: (names: string, k: number) => `Más en camino: ${names} y ${k} más están en desarrollo.`,
        seeAll: 'Ver todos los juegos próximos →', faq: 'Preguntas frecuentes',
        ctaH: '¿Listo para repartir?',
        ctaP: 'Descarga gratis la app Card Games by Vanikar en iOS o Android — todos los juegos desbloqueados durante 2 semanas, sin tarjeta de crédito.',
        pricing: 'Ver precios' },
  pt: { browse: 'Ver todos os jogos', soon: 'Em breve',
        more: (names: string, k: number) => `Mais a caminho: ${names} e outros ${k} estão em desenvolvimento.`,
        seeAll: 'Ver todos os jogos em breve →', faq: 'Perguntas frequentes',
        ctaH: 'Pronto para dar as cartas?',
        ctaP: 'Baixe grátis o app Card Games by Vanikar no iOS ou Android — todos os jogos liberados por 2 semanas, sem cartão de crédito.',
        pricing: 'Ver preços' },
  fr: { browse: 'Voir tous les jeux', soon: 'Bientôt',
        more: (names: string, k: number) => `D’autres arrivent : ${names} et ${k} autres sont en développement.`,
        seeAll: 'Voir tous les jeux à venir →', faq: 'Questions fréquentes',
        ctaH: 'Prêt à distribuer ?',
        ctaP: 'Téléchargez gratuitement l’app Card Games by Vanikar sur iOS ou Android — tous les jeux débloqués pendant 2 semaines, sans carte bancaire.',
        pricing: 'Voir les tarifs' },
  de: { browse: 'Alle Spiele ansehen', soon: 'Bald verfügbar',
        more: (names: string, k: number) => `Weitere folgen: ${names} und ${k} weitere sind in Entwicklung.`,
        seeAll: 'Alle kommenden Spiele ansehen →', faq: 'Häufige Fragen',
        ctaH: 'Bereit zum Geben?',
        ctaP: 'Lade die App Card Games by Vanikar kostenlos für iOS oder Android — alle Spiele 2 Wochen lang freigeschaltet, ohne Kreditkarte.',
        pricing: 'Preise ansehen' },
  hi: { browse: 'सभी खेल देखें', soon: 'जल्द आ रहा है',
        more: (names: string, k: number) => `और भी आ रहे हैं: ${names} और ${k} अन्य खेल विकास में हैं।`,
        seeAll: 'आने वाले सभी खेल देखें →', faq: 'अक्सर पूछे जाने वाले सवाल',
        ctaH: 'पत्ते बाँटने को तैयार?',
        ctaP: 'Card Games by Vanikar ऐप iOS या Android पर मुफ़्त डाउनलोड करें — 2 हफ़्ते तक सभी खेल अनलॉक, क्रेडिट कार्ड की ज़रूरत नहीं।',
        pricing: 'कीमतें देखें' },
  it: { browse: 'Sfoglia tutti i giochi', soon: 'In arrivo',
        more: (names: string, k: number) => `Altri in arrivo: ${names} e altri ${k} sono in sviluppo.`,
        seeAll: 'Vedi tutti i giochi in arrivo →', faq: 'Domande frequenti',
        ctaH: 'Pronto a dare le carte?',
        ctaP: 'Scarica gratis l’app Card Games by Vanikar su iOS o Android — tutti i giochi sbloccati per 2 settimane, senza carta di credito.',
        pricing: 'Vedi i prezzi' },
  ja: { browse: 'すべてのゲームを見る', soon: '近日公開',
        more: (names: string, k: number) => `さらに追加予定：${names}、ほか${k}タイトルが開発中です。`,
        seeAll: '近日公開のゲームをすべて見る →', faq: 'よくある質問',
        ctaH: '配りますか？',
        ctaP: 'Card Games by VanikarアプリをiOSまたはAndroidで無料ダウンロード——2週間すべてのゲームが解放、クレジットカード不要。',
        pricing: '料金を見る' },
}[lang];

const iconModules = import.meta.glob<{ default: ImageMetadata }>('../assets/game-icons/*.{png,svg}', { eager: true });
const gameIcon = (slug: string) =>
  iconModules[`../assets/game-icons/${slug}.png`]?.default ??
  iconModules[`../assets/game-icons/${slug}.svg`]?.default;

const csNames = comingSoonGames.slice(0, 8).map(g => localizeGame(g, lang).name).join(', ');
---

<section class="fl-hero">
  <div class="container">
    <div class="section-tag">♠ ♥ ♦ ♣</div>
    <h1>{h1}</h1>
    <p class="fl-intro">{intro}</p>
    <div class="fl-actions">
      <button type="button" data-store="App Store / Google Play" class="btn btn-primary">{LN.notify}</button>
      <a href={href('/games')} class="btn btn-secondary">{C.browse}</a>
    </div>
  </div>
</section>

<section class="fl-content">
  <div class="container">
    <div class="fl-sections">
      {sections.map(s => (
        <div class="fl-section">
          <h2>
            {s.heading}
            {s.soon && <span class="fl-soon-badge">{C.soon}</span>}
          </h2>
          <p>{s.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="fl-games">
  <div class="container">
    <h2>{gamesHeading}</h2>
    <p class="fl-games-sub">{gamesSub}</p>
    <div class="fl-grid">
      {avail.map(game => (
        <a href={href(`/games/${game.slug}/`)} class="fl-card">
          <span class="fl-icon">
            {gameIcon(game.slug)
              ? <Image src={gameIcon(game.slug)!} alt="" width={56} class="gi-img" />
              : game.icon}
          </span>
          <span class="fl-body">
            <span class="fl-name">{game.name}</span>
            <span class="fl-tag">{game.tagline}</span>
          </span>
          <span class="fl-arrow">›</span>
        </a>
      ))}
    </div>
    <p class="fl-soon">
      {C.more(csNames, comingSoonGames.length - 8)}
      <a href={href('/games#coming-soon-group')}>{C.seeAll}</a>
    </p>
  </div>
</section>

<section class="fl-faq">
  <div class="container">
    <h2>{C.faq}</h2>
    {faqs.map(f => (
      <details class="faq-item">
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}
  </div>
</section>

<section class="fl-cta">
  <div class="container">
    <h2>{C.ctaH}</h2>
    <p>{C.ctaP}</p>
    <div class="fl-actions">
      <button type="button" data-store="App Store / Google Play" class="btn btn-primary">{LN.notify}</button>
      <a href={href('/pricing')} class="btn btn-secondary">{C.pricing}</a>
    </div>
  </div>
</section>

<style>
  .fl-hero {
    background: linear-gradient(180deg, var(--bg-deep) 0%, var(--bg-primary) 100%);
    padding: 4rem 0 3rem; border-bottom: 1px solid var(--border); text-align: center;
  }
  .fl-hero h1 { font-size: clamp(2rem,5vw,3.2rem); margin: .5rem 0 1rem; }
  .fl-intro {
    font-size: 1.05rem; color: var(--text-secondary); line-height: 1.8;
    max-width: 720px; margin: 0 auto 2rem;
  }
  .fl-actions { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }

  .fl-content { padding: 3.5rem 0 1rem; }
  .fl-sections { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; max-width: 960px; margin: 0 auto; }
  .fl-section {
    background: var(--bg-card); border: 1px solid var(--border);
    border-radius: var(--radius-lg); padding: 1.5rem;
  }
  .fl-section h2 {
    font-size: 1.05rem; font-weight: 700; color: var(--gold-light);
    font-family: 'Inter Variable',sans-serif; margin-bottom: .6rem;
  }
  .fl-section p { font-size: .9rem; color: var(--text-secondary); line-height: 1.75; }
  .fl-soon-badge {
    display: inline-block; margin-left: .5rem; vertical-align: middle;
    padding: .12rem .55rem; border-radius: var(--radius-full);
    font-size: .6rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase;
    color: #b490f5; border: 1px solid rgba(180,144,245,.35);
    background: rgba(120,80,200,.12);
  }
  @media (max-width: 720px) { .fl-sections { grid-template-columns: 1fr; } }

  .fl-games { padding: 3rem 0; }
  .fl-games h2 { font-size: 1.4rem; margin-bottom: .35rem; }
  .fl-games-sub { font-size: .9rem; color: var(--text-muted); margin-bottom: 1.5rem; }
  .fl-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px,1fr)); gap: .75rem; }
  .fl-card {
    display: flex; align-items: center; gap: .85rem;
    background: var(--bg-card); border: 1px solid var(--border);
    border-radius: var(--radius-md); padding: .9rem 1rem;
    transition: all var(--transition); text-decoration: none; color: inherit;
  }
  .fl-card:hover { border-color: var(--gold-border); transform: translateY(-2px); }
  .fl-icon { font-size: 1.6rem; flex-shrink: 0; }
  .fl-icon :global(.gi-img) { width: 40px; height: 40px; object-fit: contain; display: block; }
  .fl-body { display: flex; flex-direction: column; gap: .15rem; min-width: 0; }
  .fl-name { font-size: .9rem; font-weight: 600; color: var(--text-primary); }
  .fl-tag  { font-size: .75rem; color: var(--text-muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .fl-arrow { margin-left: auto; color: var(--text-dim); }
  .fl-card:hover .fl-arrow { color: var(--gold); }
  .fl-soon { margin-top: 1.5rem; font-size: .85rem; color: var(--text-muted); line-height: 1.7; }
  .fl-soon a { color: var(--gold-light); }

  .fl-faq { padding: 1rem 0 3rem; }
  .fl-faq h2 { font-size: 1.4rem; margin-bottom: 1.25rem; }
  .faq-item {
    border: 1px solid var(--border); border-radius: var(--radius-md);
    background: var(--bg-card); margin-bottom: .6rem; overflow: hidden; max-width: 860px;
  }
  .faq-item summary {
    cursor: pointer; padding: .85rem 1.1rem; font-size: .9rem; font-weight: 600;
    color: var(--text-primary); font-family: 'Inter Variable',sans-serif;
    list-style: none; position: relative; padding-right: 2.2rem;
    transition: color var(--transition);
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after {
    content: '+'; position: absolute; right: 1.1rem; top: 50%; translate: 0 -50%;
    color: var(--gold); font-size: 1.1rem; transition: transform var(--transition);
  }
  .faq-item[open] summary::after { transform: rotate(45deg); }
  .faq-item summary:hover { color: var(--gold-light); }
  .faq-item p { padding: 0 1.1rem .95rem; font-size: .875rem; color: var(--text-secondary); line-height: 1.7; }

  .fl-cta {
    background: var(--bg-deep); border-top: 1px solid var(--border);
    padding: 3.5rem 0; text-align: center;
  }
  .fl-cta h2 { font-size: 1.5rem; margin-bottom: .6rem; }
  .fl-cta p { font-size: .95rem; color: var(--text-secondary); max-width: 560px; margin: 0 auto 1.75rem; line-height: 1.75; }
</style>
