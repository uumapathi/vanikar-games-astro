---
/**
 * Visible breadcrumb trail. Pages that render this also emit the matching
 * BreadcrumbList JSON-LD, so the markup and the schema stay in step.
 * The last item is the current page and is not linked.
 */
interface Crumb { name: string; href?: string }
interface Props { items: Crumb[] }
const { items } = Astro.props;
---
<nav class="crumbs" aria-label="Breadcrumb">
  <ol>
    {items.map((c, i) => (
      <li>
        {c.href && i < items.length - 1
          ? <a href={c.href}>{c.name}</a>
          : <span aria-current="page">{c.name}</span>}
      </li>
    ))}
  </ol>
</nav>

<style>
  .crumbs ol { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: .35rem; font-size: .82rem; }
  .crumbs li + li::before { content: '›'; margin-right: .35rem; color: var(--text-dim); }
  .crumbs a { color: var(--text-muted); text-decoration: none; transition: color var(--transition); }
  .crumbs a:hover { color: var(--gold-light); }
  .crumbs [aria-current] { color: var(--text-secondary); }
</style>
