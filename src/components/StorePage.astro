---
<BaseLayout title={L.title} description={L.description}>
  <div class:list={['store-page', ios ? 'store-page--ios' : 'store-page--android']}>

    <div class="store-hero">
      <div class="container">
        <a href={href('/')} class="back-link">{L.back}</a>

        <div class="store-hero-inner">
          <img class="store-appicon" src="/icon-180.png" width="112" height="112" alt={L.iconAlt} />
          <div class="platform-badge">
            <span class="platform-icon" aria-hidden="true">
              {ios
                ? <svg viewBox="0 0 384 512" width="16" height="16" fill="currentColor" style="display:block"><path d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z"/></svg>
                : <svg viewBox="0 0 512 512" width="16" height="16" fill="currentColor" style="display:block"><path d="M325.3 234.3L104.6 13l280.8 161.2-60.1 60.1zM47 0C34 6.8 25.3 19.2 25.3 35.3v441.3c0 16.1 8.7 28.5 21.7 35.3l256.6-256L47 0zm425.2 225.6l-58.9-34.1-65.7 64.5 65.7 64.5 60.1-34.1c18-14.3 18-46.5-1.2-60.8zM104.6 499l280.8-161.2-60.1-60.1L104.6 499z"/></svg>}
            </span>
            <span>{L.badge}</span>
          </div>

          <h1 class="store-title">{L.soon}<br/>{L.on} <span class="platform-accent">{P}</span></h1>
          <p class="store-subtitle">{L.subtitle}</p>
          <div class="store-meta">
            {L.chips.map(c => <span class="meta-chip">{c}</span>)}
          </div>
        </div>
      </div>
    </div>

    <!-- Notify -->
    <section class="notify-section">
      <div class="container notify-inner">
        <div class="notify-copy">
          <h2>{L.notifyH}</h2>
          <p>{L.notifyP}</p>
        </div>
        <form class="notify-form" id={`notify-form-${id}`} novalidate>
          <input type="email" id={`notify-email-${id}`} placeholder={L.placeholder}
                 required class="notify-input" aria-label={L.emailLabel} />
          <button type="button" class="btn btn-primary notify-btn"
                  id={`notify-btn-${id}`} data-sending={L.sending} data-platform={P}>{L.notifyBtn}</button>
        </form>
        <p class="notify-fine" id={`notify-confirm-${id}`} hidden>{L.confirm}</p>
      </div>
    </section>

    <!-- Features -->
    <section class="store-features">
      <div class="container">
        <h2 class="section-title" style="text-align:center;margin-bottom:2.5rem">{L.inside}</h2>
        <div class="sf-grid">
          {L.features.map(([icon, h, p]) => (
            <div class="sf-card">
              <span class="sf-icon">{icon}</span>
              <h3>{h}</h3>
              <p>{p}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <div class="store-footer-cta">
      <div class="container" style="text-align:center">
        <p>{L.footerP}</p>
        <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;margin-top:1.25rem">
          <a href={href('/games')}   class="btn btn-primary">{L.browse}</a>
          <a href={href('/pricing')} class="btn btn-secondary">{L.pricing}</a>
          <a href={href(other)}      class="btn btn-secondary">{L.otherPage}</a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  // Launch-notification signup → Google Forms (same form as the home page).
  const GF_FORM_ID     = '1FAIpQLSeEtXUBBZXTR602ygQLThvrW1MTFbmky5ZaMa3caILWr9S4nQ';
  const GF_EMAIL_ENTRY = 'entry.302574150';

  document.querySelectorAll<HTMLButtonElement>('.notify-btn').forEach(btn => {
    const form    = btn.closest('form')!;
    const input   = form.querySelector('input') as HTMLInputElement;
    const confirm = form.nextElementSibling as HTMLElement;

    btn.addEventListener('click', async () => {
      if (!input.checkValidity() || !input.value) { input.reportValidity(); return; }
      btn.textContent = btn.dataset.sending ?? '…';
      btn.setAttribute('disabled', 'true');
      try {
        await fetch(`https://docs.google.com/forms/d/e/${GF_FORM_ID}/formResponse`, {
          method: 'POST',
          mode: 'no-cors',   // Google Forms doesn't allow CORS; response is opaque
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams({
            [GF_EMAIL_ENTRY]: input.value,
            'entry.platform': btn.dataset.platform ?? '',   // ignored if the field doesn't exist
          }).toString(),
        });
      } catch {
        // no-cors always throws on response reading — submission still goes through
      }
      form.style.display = 'none';
      confirm.hidden = false;
    });
  });
</script>

<style>
  .store-page--ios     { --platform-color: #1d9af5; --platform-dark: #0a6fc2; --platform-rgb: 29,154,245;  --hero-tint: #091822; }
  .store-page--android { --platform-color: #3ddc84; --platform-dark: #1ea85b; --platform-rgb: 61,220,132;  --hero-tint: #091a0f; }

  .store-hero {
    background: linear-gradient(160deg, var(--bg-deep) 0%, var(--hero-tint) 100%);
    padding: 5rem 0 4rem; border-bottom: 1px solid var(--border);
  }
  .back-link { font-size: .82rem; color: var(--text-muted); transition: color var(--transition); display: inline-block; margin-bottom: 2.5rem; }
  .back-link:hover { color: var(--gold-light); }

  .store-hero-inner { max-width: 680px; }
  .store-appicon {
    width: 112px; height: 112px; border-radius: 24px; display: block;
    margin-bottom: 1.5rem;
    box-shadow: 0 14px 36px rgba(0,0,0,.5), 0 0 26px rgba(201,162,39,.15);
  }
  .platform-badge {
    display: inline-flex; align-items: center; gap: .5rem;
    background: rgba(var(--platform-rgb),.12); border: 1px solid rgba(var(--platform-rgb),.3);
    border-radius: var(--radius-full); padding: .4rem 1rem;
    font-size: .78rem; font-weight: 700; letter-spacing: .1em;
    text-transform: uppercase; color: var(--platform-color); margin-bottom: 1.25rem;
  }
  .platform-icon { font-size: 1.1rem; }
  .store-title {
    font-size: clamp(2.5rem,6vw,4.5rem); font-weight: 900;
    line-height: 1.1; margin-bottom: 1rem; color: var(--text-primary);
  }
  .platform-accent { color: var(--platform-color); }
  .store-subtitle { font-size: 1.05rem; color: var(--text-muted); line-height: 1.75; margin-bottom: 1.5rem; max-width: 580px; }
  .store-meta { display: flex; gap: .5rem; flex-wrap: wrap; }
  .meta-chip {
    background: var(--bg-card); border: 1px solid var(--border);
    border-radius: var(--radius-full); padding: .3rem .85rem;
    font-size: .78rem; color: var(--text-secondary);
  }

  /* Notify */
