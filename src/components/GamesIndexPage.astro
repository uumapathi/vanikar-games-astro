---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { games, comingSoonGames, availableGames } from '../data/games';
import { localizeGame } from '../data/games.i18n';
import { getLocale, localizedHref } from '../i18n';

const iconModules = import.meta.glob<{ default: ImageMetadata }>('../assets/game-icons/*.{png,svg}', { eager: true });
const gameIcon = (slug: string) =>
  iconModules[`../assets/game-icons/${slug}.png`]?.default ??
  iconModules[`../assets/game-icons/${slug}.svg`]?.default;

const total    = games.length;
const csCount  = comingSoonGames.length;
const avail    = availableGames.length;

const lang = getLocale(Astro.currentLocale);
const href = (p: string) => localizedHref(p, lang);
const availL = availableGames.map(g => localizeGame(g, lang));
const soonL  = comingSoonGames.map(g => localizeGame(g, lang));

const diffLabel: Record<string, Record<string, string>> = {
  en: { Easy: 'Easy', Medium: 'Medium', Hard: 'Hard' },
  es: { Easy: 'Fácil', Medium: 'Media', Hard: 'Difícil' },
  pt: { Easy: 'Fácil', Medium: 'Média', Hard: 'Difícil' },
  fr: { Easy: 'Facile', Medium: 'Moyen', Hard: 'Difficile' },
  de: { Easy: 'Leicht', Medium: 'Mittel', Hard: 'Schwer' },
  hi: { Easy: 'आसान', Medium: 'मध्यम', Hard: 'कठिन' },
};

const L = {
  en: {
    title: `All ${total} Card Games | Vanikar`,
    description: `Explore all ${total} card games on Vanikar: Hearts, Spades, Big Two, Durak, Belote, Indian Rummy, Truco, Cribbage, Skat and many more. Rules, how to play, strategy tips.`,
    h1: 'All Card Games',
    lead: `${avail} games available now · ${csCount} more coming soon — all free during your 2-week trial.`,
    premium: 'Premium', comingSoon: 'Coming Soon',
    availDesc: `${avail} games available now`, soonDesc: `${csCount} games in development`,
    premiumTitle: 'Premium Games', soonTitle: 'In Development',
    gamesCount: (n: number) => `${n} games`,
    premiumSub: 'The most popular games in each region. Fully unlocked during trial. New games go to premium subscribers first.',
    soonSub: 'These games are in development and will be added to the app. Premium subscribers get access first.',
    ctaSub: 'Try every game free for 2 weeks. No credit card required.',
    ctaPricing: 'View Pricing', ctaDownload: 'Download Free',
  },
  es: {
    title: `Los ${total} juegos de cartas | Vanikar`,
    description: `Explora los ${total} juegos de cartas de Vanikar: Corazones, Espadas, Big Two, Durak, Belote, Rummy Indio, Truco, Cribbage, Skat y muchos más. Reglas, cómo jugar y consejos de estrategia.`,
    h1: 'Todos los juegos de cartas',
    lead: `${avail} juegos disponibles ahora · ${csCount} más próximamente — todos gratis durante tu prueba de 2 semanas.`,
    premium: 'Premium', comingSoon: 'Próximamente',
    availDesc: `${avail} juegos disponibles ahora`, soonDesc: `${csCount} juegos en desarrollo`,
    premiumTitle: 'Juegos Premium', soonTitle: 'En desarrollo',
    gamesCount: (n: number) => `${n} juegos`,
    premiumSub: 'Los juegos más populares de cada región. Totalmente desbloqueados durante la prueba. Los nuevos juegos llegan primero a los suscriptores premium.',
    soonSub: 'Estos juegos están en desarrollo y se añadirán a la app. Los suscriptores premium acceden primero.',
    ctaSub: 'Prueba todos los juegos gratis por 2 semanas. Sin tarjeta de crédito.',
    ctaPricing: 'Ver precios', ctaDownload: 'Descarga gratis',
  },
  pt: {
    title: `Todos os ${total} jogos de cartas | Vanikar`,
    description: `Explore todos os ${total} jogos de cartas do Vanikar: Copas, Espadas, Big Two, Durak, Belote, Rummy Indiano, Truco, Cribbage, Skat e muitos mais. Regras, como jogar e dicas de estratégia.`,
    h1: 'Todos os jogos de cartas',
    lead: `${avail} jogos disponíveis agora · ${csCount} mais em breve — todos grátis durante seu teste de 2 semanas.`,
    premium: 'Premium', comingSoon: 'Em breve',
    availDesc: `${avail} jogos disponíveis agora`, soonDesc: `${csCount} jogos em desenvolvimento`,
    premiumTitle: 'Jogos Premium', soonTitle: 'Em desenvolvimento',
    gamesCount: (n: number) => `${n} jogos`,
    premiumSub: 'Os jogos mais populares de cada região. Totalmente desbloqueados durante o teste. Os novos jogos chegam primeiro aos assinantes premium.',
    soonSub: 'Estes jogos estão em desenvolvimento e serão adicionados ao app. Assinantes premium têm acesso primeiro.',
    ctaSub: 'Experimente todos os jogos grátis por 2 semanas. Sem cartão de crédito.',
    ctaPricing: 'Ver preços', ctaDownload: 'Baixe grátis',
  },
  fr: {
    title: `Les ${total} jeux de cartes | Vanikar`,
    description: `Découvrez les ${total} jeux de cartes de Vanikar : Cœurs, Piques, Big Two, Durak, Belote, Rami indien, Truco, Cribbage, Skat et bien d'autres. Règles, comment jouer et conseils de stratégie.`,
    h1: 'Tous les jeux de cartes',
    lead: `${avail} jeux disponibles dès maintenant · ${csCount} autres bientôt — tous gratuits pendant votre essai de 2 semaines.`,
    premium: 'Premium', comingSoon: 'Bientôt disponible',
    availDesc: `${avail} jeux disponibles dès maintenant`, soonDesc: `${csCount} jeux en développement`,
    premiumTitle: 'Jeux Premium', soonTitle: 'En développement',
    gamesCount: (n: number) => `${n} jeux`,
    premiumSub: "Les jeux les plus populaires de chaque région. Entièrement débloqués pendant l'essai. Les nouveaux jeux arrivent d'abord chez les abonnés premium.",
    soonSub: "Ces jeux sont en développement et seront ajoutés à l'app. Les abonnés premium y accèdent en premier.",
    ctaSub: 'Essayez tous les jeux gratuitement pendant 2 semaines. Sans carte bancaire.',
    ctaPricing: 'Voir les tarifs', ctaDownload: 'Télécharger gratuitement',
  },
  de: {
    title: `Alle ${total} Kartenspiele | Vanikar`,
    description: `Entdecke alle ${total} Kartenspiele von Vanikar: Hearts, Spades, Big Two, Durak, Belote, Indisches Rommé, Truco, Cribbage, Skat und viele mehr. Regeln, Spielanleitungen und Strategie-Tipps.`,
    h1: 'Alle Kartenspiele',
    lead: `${avail} Spiele jetzt verfügbar · ${csCount} weitere demnächst — alle kostenlos während deiner 2-wöchigen Testphase.`,
    premium: 'Premium', comingSoon: 'Demnächst',
    availDesc: `${avail} Spiele jetzt verfügbar`, soonDesc: `${csCount} Spiele in Entwicklung`,
    premiumTitle: 'Premium-Spiele', soonTitle: 'In Entwicklung',
    gamesCount: (n: number) => `${n} Spiele`,
    premiumSub: 'Die beliebtesten Spiele jeder Region. Während der Testphase voll freigeschaltet. Neue Spiele erhalten Premium-Abonnenten zuerst.',
    soonSub: 'Diese Spiele sind in Entwicklung und werden der App hinzugefügt. Premium-Abonnenten erhalten zuerst Zugriff.',
    ctaSub: 'Teste jedes Spiel 2 Wochen lang kostenlos. Keine Kreditkarte nötig.',
    ctaPricing: 'Preise ansehen', ctaDownload: 'Kostenlos herunterladen',
  },
  hi: {
    title: `सभी ${total} ताश के खेल | Vanikar`,
    description: `Vanikar के सभी ${total} ताश के खेल देखें: Hearts, Spades, Big Two, Durak, Belote, Indian Rummy, Truco, Cribbage, Skat और भी बहुत कुछ। नियम, खेलने का तरीका और रणनीति के सुझाव।`,
    h1: 'सभी ताश के खेल',
    lead: `${avail} खेल अभी उपलब्ध · ${csCount} और जल्द आ रहे हैं — आपके 2-सप्ताह के ट्रायल में सभी मुफ़्त।`,
    premium: 'Premium', comingSoon: 'जल्द आ रहा है',
    availDesc: `${avail} खेल अभी उपलब्ध`, soonDesc: `${csCount} खेल विकास में`,
    premiumTitle: 'Premium खेल', soonTitle: 'विकास में',
    gamesCount: (n: number) => `${n} खेल`,
    premiumSub: 'हर क्षेत्र के सबसे लोकप्रिय खेल। ट्रायल के दौरान पूरी तरह अनलॉक। नए खेल सबसे पहले Premium सदस्यों को मिलते हैं।',
    soonSub: 'ये खेल विकास में हैं और ऐप में जोड़े जाएँगे। Premium सदस्यों को सबसे पहले एक्सेस मिलता है।',
    ctaSub: 'सभी खेल 2 सप्ताह तक मुफ़्त आज़माएँ। क्रेडिट कार्ड की ज़रूरत नहीं।',
    ctaPricing: 'कीमतें देखें', ctaDownload: 'मुफ़्त डाउनलोड करें',
  },
}[lang];
---

<BaseLayout
  title={L.title}
  description={L.description}
>

  <!-- Hero -->
  <section class="games-hero">
    <div class="container">
      <div class="section-tag">♠ ♥ ♦ ♣</div>
      <h1>{L.h1}</h1>
      <p class="games-lead">{L.lead}</p>
      <div class="tier-legend">
        <span class="badge badge-premium">{L.premium}</span>
        <span class="badge-desc">{L.availDesc}</span>
        <span class="badge badge-soon">{L.comingSoon}</span>
        <span class="badge-desc">{L.soonDesc}</span>
      </div>
    </div>
  </section>

  <!-- Games grid -->
  <section class="games-section">
    <div class="container">

      <!-- Premium games -->
      <div id="premium-group" class="games-group games-group--premium">
        <h2 class="games-group-title">
          <span class="badge badge-premium">{L.premium}</span>
          {L.premiumTitle}
          <span class="games-count" id="prm-count">{L.gamesCount(avail)}</span>
        </h2>
        <p class="games-group-sub">{L.premiumSub}</p>

        <div class="games-grid" id="premium-grid">
          {availL.map(game => (
            <a href={href(`/games/${game.slug}/`)} class="game-card game-card--premium">
              <div class="game-card-icon">
                {gameIcon(game.slug)
                  ? <Image src={gameIcon(game.slug)!} alt="" width={88} class="gi-img" />
                  : game.icon}
              </div>
              <div class="game-card-body">
                <div class="game-card-header">
                  <h3 class="game-card-name">{game.name}</h3>
                  <span class={`diff-badge diff-${game.difficulty.toLowerCase()}`}>{diffLabel[lang][game.difficulty]}</span>
                </div>
                <p class="game-card-tagline">{game.tagline}</p>
                <div class="game-card-meta">
                  <span>👥 {game.playerCount}</span>
                  <span class="badge badge-premium badge-sm">{L.premium}</span>
                </div>
              </div>
              <span class="game-card-arrow">›</span>
            </a>
          ))}
        </div>
      </div>

      <!-- Coming Soon -->
      <div id="coming-soon-group" class="games-group games-group--soon">
        <h2 class="games-group-title">
          <span class="badge badge-soon">{L.comingSoon}</span>
          {L.soonTitle}
          <span class="games-count" id="cs-count">{L.gamesCount(csCount)}</span>
        </h2>
        <p class="games-group-sub">{L.soonSub}</p>

        <div class="games-grid" id="coming-soon-grid">
          {soonL.map(game => (
            <a href={href(`/games/${game.slug}/`)} class="game-card game-card--soon">
              <div class="game-card-icon soon-icon">
                {gameIcon(game.slug)
                  ? <Image src={gameIcon(game.slug)!} alt="" width={88} class="gi-img" />
                  : game.icon}
              </div>
              <div class="game-card-body">
                <div class="game-card-header">
                  <h3 class="game-card-name">{game.name}</h3>
                  <span class={`diff-badge diff-${game.difficulty.toLowerCase()}`}>{diffLabel[lang][game.difficulty]}</span>
                  <span class="badge badge-soon badge-sm">{L.comingSoon}</span>
                </div>
                <p class="game-card-tagline">{game.tagline}</p>
                <div class="game-card-meta"><span>👥 {game.playerCount}</span></div>
              </div>
              <span class="game-card-arrow">›</span>
            </a>
          ))}
        </div>
      </div>

    </div>
  </section>

  <!-- CTA -->
  <section class="games-cta">
    <div class="container" style="text-align:center">
      <p class="games-cta-sub">{L.ctaSub}</p>
      <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;margin-top:1.5rem">
        <a href={href('/pricing')}   class="btn btn-primary">{L.ctaPricing}</a>
        <a href={href('/#download')} class="btn btn-secondary">{L.ctaDownload}</a>
      </div>
    </div>
  </section>

</BaseLayout>


<style>
  /* Hero */
  .games-hero { background: linear-gradient(180deg,var(--bg-deep) 0%,var(--bg-primary) 100%); padding: 4rem 0 2.5rem; text-align: center; border-bottom: 1px solid var(--border); }
  .games-hero h1 { font-size: clamp(2.2rem,5vw,3.5rem); margin-bottom: .75rem; }
  .games-lead    { font-size: 1.05rem; color: var(--text-muted); max-width: 560px; margin: 0 auto 1.25rem; line-height: 1.7; }
  .tier-legend   { display: inline-flex; align-items: center; gap: .6rem; flex-wrap: wrap; justify-content: center; font-size: .82rem; }
  .badge-desc    { color: var(--text-dim); }

  /* Badges */
  .badge         { display: inline-block; padding: .2rem .6rem; border-radius: var(--radius-full); font-size: .68rem; font-weight: 700; text-transform: uppercase; letter-spacing: .1em; }
  .badge-premium { background: rgba(201,162,39,.15); color: var(--gold); border: 1px solid var(--gold-border); }
  .badge-sm      { font-size: .62rem; padding: .12rem .45rem; }

/* Section */
  .games-section { padding: 2.5rem 0 4rem; }
  .games-group { margin-bottom: 3.5rem; }
  .games-group--premium { background: var(--bg-secondary); border-top: 1px solid var(--border); border-radius: var(--radius-lg); padding: 2rem; }
  .games-group-title { display: flex; align-items: center; gap: .6rem; flex-wrap: wrap; font-size: 1.3rem; margin-bottom: .4rem; }
  .games-count { font-size: .82rem; color: var(--text-dim); font-family: 'Inter',sans-serif; font-weight: 400; margin-left: auto; }
  .games-group-sub { font-size: .875rem; color: var(--text-muted); margin-bottom: 1.5rem; max-width: 640px; }
  .games-group-empty { font-size: .875rem; color: var(--text-dim); margin-top: 1rem; }

  /* Card grid */
  .games-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(290px,1fr)); gap: .85rem; }

  .game-card { display: flex; align-items: flex-start; gap: .9rem; background: var(--bg-feature); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 1.1rem 1.2rem; transition: all var(--transition); text-decoration: none; color: inherit; }
  .game-card--premium { border-color: var(--gold-border); }
  .game-card:hover { border-color: var(--gold-border); background: var(--bg-card-elevated); transform: translateY(-2px); box-shadow: var(--shadow-md), var(--glow-gold); }

  .game-card-icon { font-size: 1.9rem; flex-shrink: 0; width: 44px; text-align: center; margin-top: .1rem; }
  .game-card-icon :global(.gi-img) { width: 44px; height: 44px; object-fit: contain; display: block; }
  .game-card-body { flex: 1; min-width: 0; }
  .game-card-header { display: flex; align-items: center; gap: .4rem; margin-bottom: .2rem; flex-wrap: wrap; }
  .game-card-name  { font-size: .9rem; font-weight: 700; font-family: 'Inter',sans-serif; color: var(--text-primary); }

  .diff-badge       { font-size: .62rem; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; padding: .12rem .45rem; border-radius: var(--radius-full); border: 1px solid; }
  .diff-easy        { background: rgba(45,90,45,.2);  color: #7acc7a; border-color: rgba(122,204,122,.3); }
  .diff-medium      { background: rgba(122,90,16,.2); color: #d4a020; border-color: rgba(212,160,32,.3); }
  .diff-hard        { background: rgba(100,26,26,.2); color: #e07070; border-color: rgba(180,60,60,.3); }

  .game-card-tagline { font-size: .8rem; color: var(--text-muted); line-height: 1.5; margin-bottom: .35rem; }
  .game-card-meta    { display: flex; align-items: center; gap: .4rem; font-size: .72rem; color: var(--text-dim); flex-wrap: wrap; margin-bottom: .3rem; }


  .game-card-arrow { color: var(--text-dim); font-size: 1.3rem; margin-left: auto; flex-shrink: 0; align-self: center; transition: transform var(--transition), color var(--transition); }
  .game-card:hover .game-card-arrow { transform: translateX(4px); color: var(--gold); }

  /* Coming Soon group */
  .games-group--soon { background: var(--bg-secondary); border-top: 1px solid var(--border); border-radius: var(--radius-lg); padding: 2rem; opacity: .85; }
  .badge-soon  { background: rgba(120,80,200,.18); color: #b490f5; border: 1px solid rgba(180,144,245,.3); }
  .game-card--soon { opacity: .7; border-style: dashed; }
  .game-card--soon:hover { opacity: 1; }
  .soon-icon { filter: grayscale(40%); }

  /* CTA */
  .games-cta     { background: var(--bg-deep); border-top: 1px solid var(--border); padding: 3rem 0; }
  .games-cta-sub { font-size: 1rem; color: var(--text-muted); }
</style>
