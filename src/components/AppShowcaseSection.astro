    { image: shot('profile'),             title: 'Il tuo profilo',          caption: 'Scegli avatar e nome visualizzato — è così che gli altri ti vedono nelle lobby e nelle sale.' },
    { image: shot('login'),               title: 'Accedi',                  caption: 'Accedi per sincronizzare profilo, statistiche e abbonamento su tutti i dispositivi.' },
