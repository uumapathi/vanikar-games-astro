---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ScreenshotLightbox from './ScreenshotLightbox.astro';
import { getLocale } from '../i18n';

const shotModules = import.meta.glob<{ default: ImageMetadata }>('../assets/screenshots/app/*.png', { eager: true });
const shot = (name: string) => shotModules[`../assets/screenshots/app/${name}.png`].default;

const lang = getLocale(Astro.currentLocale);

/* Featured screens shown large, then the supporting tour */
const featuredByLang = {
  en: [
    { image: shot('home'),                    title: 'Home',           caption: 'Jump into Practice, Online tables, Clubs, or Tournaments straight from the home screen.' },
    { image: shot('offline-game-selection'),  title: 'Pick your game', caption: 'Curated card rooms with large icons and clear player counts — your next game is one tap away.' },
    { image: shot('settings-appearance'),     title: 'Make it yours',  caption: 'Table themes from Royal Felt to Midnight Indigo — dark and light, all in burnished gold.' },
  ],
  es: [
    { image: shot('home'),                    title: 'Inicio',         caption: 'Entra a Práctica, mesas en línea, Clubes o Torneos directo desde la pantalla principal.' },
    { image: shot('offline-game-selection'),  title: 'Elige tu juego', caption: 'Salas de cartas seleccionadas con iconos grandes y número de jugadores claro — tu próxima partida está a un toque.' },
    { image: shot('settings-appearance'),     title: 'Hazla tuya',     caption: 'Temas de mesa desde Fieltro Real hasta Índigo Medianoche — oscuros y claros, todos en oro bruñido.' },
  ],
  pt: [
    { image: shot('home'),                    title: 'Início',            caption: 'Entre em Prática, mesas online, Clubes ou Torneios direto da tela inicial.' },
    { image: shot('offline-game-selection'),  title: 'Escolha seu jogo',  caption: 'Salas de cartas selecionadas com ícones grandes e número de jogadores claro — seu próximo jogo está a um toque.' },
    { image: shot('settings-appearance'),     title: 'Deixe do seu jeito', caption: 'Temas de mesa do Feltro Real ao Índigo Meia-Noite — escuros e claros, todos em dourado polido.' },
  ],
  fr: [
    { image: shot('home'),                    title: 'Accueil',                caption: 'Accédez à l’entraînement, aux tables en ligne, aux Clubs ou aux Tournois directement depuis l’écran d’accueil.' },
    { image: shot('offline-game-selection'),  title: 'Choisissez votre jeu',   caption: 'Des salons de cartes soignés avec grandes icônes et nombre de joueurs bien visible — votre prochaine partie est à un geste.' },
    { image: shot('settings-appearance'),     title: 'Personnalisez-la',       caption: 'Des thèmes de table du Feutre Royal à l’Indigo de Minuit — sombres et clairs, tous en or bruni.' },
  ],
  de: [
    { image: shot('home'),                    title: 'Startseite',        caption: 'Spring direkt vom Startbildschirm in Übungsspiele, Online-Tische, Clubs oder Turniere.' },
    { image: shot('offline-game-selection'),  title: 'Wähl dein Spiel',   caption: 'Handverlesene Kartenräume mit großen Icons und klarer Spielerzahl — dein nächstes Spiel ist nur einen Tipp entfernt.' },
    { image: shot('settings-appearance'),     title: 'Mach sie zu deiner', caption: 'Tischthemen von Königlichem Filz bis Mitternachtsindigo — dunkel und hell, alle in brüniertem Gold.' },
  ],
  hi: [
    { image: shot('home'),                    title: 'होम',               caption: 'होम स्क्रीन से सीधे अभ्यास, ऑनलाइन टेबल, क्लब या टूर्नामेंट में उतरें।' },
    { image: shot('offline-game-selection'),  title: 'अपना गेम चुनें',     caption: 'बड़े आइकन और साफ़ खिलाड़ी संख्या वाले चुनिंदा कार्ड रूम — आपका अगला गेम बस एक टैप दूर।' },
    { image: shot('settings-appearance'),     title: 'इसे अपना बनाएँ',     caption: 'रॉयल फ़ेल्ट से मिडनाइट इंडिगो तक टेबल थीम — डार्क और लाइट, सब चमकते सुनहरे रंग में।' },
  ],
