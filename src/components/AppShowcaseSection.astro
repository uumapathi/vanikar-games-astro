    { image: shot('profile'),             title: 'プロフィール',           caption: 'アバターと表示名を選びましょう——ロビーやルームで他のプレイヤーに見える名前です。' },
    { image: shot('login'),               title: 'サインイン',             caption: 'ログインすると、プロフィール、成績、サブスクリプションが端末間で同期されます。' },
