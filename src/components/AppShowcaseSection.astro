const sectionCopy = {
  en: { tag: '♠ Inside the App', title: 'Take the Tour', subtitle: 'Real screens from the app — a beautifully crafted card table in your pocket.' },
  es: { tag: '♠ Dentro de la app', title: 'Haz el recorrido', subtitle: 'Pantallas reales de la app — una mesa de cartas bellamente cuidada en tu bolsillo.' },
  pt: { tag: '♠ Por dentro do app', title: 'Faça o tour', subtitle: 'Telas reais do app — uma mesa de cartas primorosamente acabada no seu bolso.' },
  fr: { tag: '♠ Au cœur de l’app', title: 'Faites le tour', subtitle: 'De vrais écrans de l’app — une table de cartes magnifiquement soignée dans votre poche.' },
  de: { tag: '♠ Ein Blick in die App', title: 'Mach die Tour', subtitle: 'Echte Screens aus der App — ein liebevoll gestalteter Kartentisch für deine Hosentasche.' },
  hi: { tag: '♠ ऐप के अंदर', title: 'टूर कीजिए', subtitle: 'ऐप की असली स्क्रीनें — शानदार ढंग से तैयार की गई ताश की टेबल आपकी जेब में।' },
  it: { tag: '♠ Dentro l’app', title: 'Fai il tour', subtitle: 'Schermate reali dell’app — un tavolo da gioco curato nei dettagli, in tasca.' },
  ja: { tag: '♠ アプリの中へ', title: 'ツアーへ', subtitle: 'アプリの実際の画面——美しく仕上げられたカードテーブルを、ポケットに。' },
}[lang];

const featured = featuredByLang[lang];
const tour     = tourByLang[lang];

/* Combined list drives the lightbox gallery; index order matches page order */
const allShots = [...featured, ...tour];
---
<section class="showcase" id="app-tour">
  <div class="container">
    <div class="section-header">
      <div class="section-tag">{sectionCopy.tag}</div>
      <h2 class="section-title">{sectionCopy.title}</h2>
      <p class="section-subtitle">{sectionCopy.subtitle}</p>
    </div>

    <div class="showcase-featured">
      {featured.map((s, i) => (
        <figure class="shot-card shot-card--featured">
          <button class="shot-zoom" data-idx={i} aria-label={`View ${s.title} screenshot full size`}>
            <Image
              src={s.image}
              alt={`Card Games app — ${s.title}`}
              width={720}
              widths={[280, 480, 720]}
              sizes="(max-width: 640px) 90vw, (max-width: 980px) 45vw, 310px"
              quality={70}
              class="shot-img"
            />
          </button>
          <figcaption>
            <strong>{s.title}</strong>
            <span>{s.caption}</span>
          </figcaption>
        </figure>
      ))}
    </div>

    <div class="showcase-tour">
      {tour.map((s, i) => (
        <figure class="shot-card">
          <button class="shot-zoom" data-idx={featured.length + i} aria-label={`View ${s.title} screenshot full size`}>
            <Image
              src={s.image}
              alt={`Card Games app — ${s.title}`}
              width={600}
              widths={[220, 400, 600]}
              sizes="(max-width: 640px) 45vw, (max-width: 980px) 30vw, 240px"
              quality={70}
              class="shot-img"
            />
          </button>
          <figcaption>
            <strong>{s.title}</strong>
            <span>{s.caption}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>

  <ScreenshotLightbox shots={allShots} altPrefix="Card Games app" />
</section>

<style>
  .showcase {
    background: var(--bg-deep);
    border-top: 1px solid var(--border);
    padding: 5rem 0;
  }

  .showcase-featured {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
    max-width: 980px;
    margin: 0 auto 1.5rem;
  }

  .showcase-tour {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1.25rem;
    max-width: 980px;
    margin: 0 auto;
  }

  .shot-card {
    margin: 0;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: all var(--transition);
  }
  .shot-card--featured { border-color: var(--gold-border); }
  .shot-card:hover {
    border-color: var(--gold-border);
    transform: translateY(-3px);
    box-shadow: var(--shadow-md), var(--glow-gold);
  }
  .shot-card :global(.shot-img) { display: block; width: 100%; height: auto; }
  .shot-card figcaption { padding: .85rem 1rem 1rem; }
  .shot-card figcaption strong {
    display: block; font-size: .85rem; color: var(--text-primary);
    font-family: 'Inter Variable',sans-serif; margin-bottom: .25rem;
  }
  .shot-card figcaption span {
    font-size: .78rem; color: var(--text-muted); line-height: 1.55;
  }

  .shot-zoom {
    display: block; width: 100%; padding: 0; margin: 0;
    background: none; border: none; cursor: zoom-in;
  }
</style>
