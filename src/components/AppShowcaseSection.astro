const tourByLang = {
  en: [
    { image: shot('slide-menu'),          title: 'Everything in reach', caption: 'Profile, settings, and legal info in one slide-out menu — play as a guest or log in.' },
    { image: shot('profile'),             title: 'Your profile',        caption: 'Pick an avatar and display name — that\'s how players see you in lobbies and rooms.' },
    { image: shot('login'),               title: 'Sign in',             caption: 'Log in to sync your profile, stats, and subscription across devices.' },
    { image: shot('register'),            title: 'Create an account',   caption: 'A quick registration unlocks online play, Clubs, and Tournaments.' },
    { image: shot('settings'),            title: 'Settings',            caption: 'Tune the app to your table style — sound, themes, and gameplay options.' },
    { image: shot('settings-animations'), title: 'Animations',          caption: 'Set dealing and card-play animation speed — snappy or cinematic, your call.' },
  ],
  es: [
    { image: shot('slide-menu'),          title: 'Todo al alcance',     caption: 'Perfil, ajustes e información legal en un menú lateral — juega como invitado o inicia sesión.' },
    { image: shot('profile'),             title: 'Tu perfil',           caption: 'Elige un avatar y un nombre — así te verán los jugadores en salas y mesas.' },
    { image: shot('login'),               title: 'Inicia sesión',       caption: 'Inicia sesión para sincronizar tu perfil, estadísticas y suscripción entre dispositivos.' },
    { image: shot('register'),            title: 'Crea una cuenta',     caption: 'Un registro rápido desbloquea el juego en línea, los Clubes y los Torneos.' },
    { image: shot('settings'),            title: 'Ajustes',             caption: 'Adapta la app a tu estilo de mesa — sonido, temas y opciones de juego.' },
    { image: shot('settings-animations'), title: 'Animaciones',         caption: 'Elige la velocidad de las animaciones de reparto y jugada — ágil o cinematográfica, tú decides.' },
  ],
  pt: [
    { image: shot('slide-menu'),          title: 'Tudo ao alcance',     caption: 'Perfil, configurações e informações legais em um menu lateral — jogue como convidado ou faça login.' },
    { image: shot('profile'),             title: 'Seu perfil',          caption: 'Escolha um avatar e um nome de exibição — é assim que os jogadores veem você em salas e lobbies.' },
    { image: shot('login'),               title: 'Entrar',              caption: 'Faça login para sincronizar seu perfil, estatísticas e assinatura entre dispositivos.' },
    { image: shot('register'),            title: 'Crie uma conta',      caption: 'Um cadastro rápido desbloqueia o jogo online, os Clubes e os Torneios.' },
    { image: shot('settings'),            title: 'Configurações',       caption: 'Ajuste o app ao seu estilo de mesa — som, temas e opções de jogo.' },
    { image: shot('settings-animations'), title: 'Animações',           caption: 'Defina a velocidade das animações de distribuição e jogada — ágil ou cinematográfica, você decide.' },
  ],
  fr: [
    { image: shot('slide-menu'),          title: 'Tout à portée de main', caption: 'Profil, réglages et mentions légales dans un menu latéral — jouez en invité ou connectez-vous.' },
    { image: shot('profile'),             title: 'Votre profil',          caption: 'Choisissez un avatar et un pseudo — c’est ainsi que les joueurs vous voient dans les salons et aux tables.' },
    { image: shot('login'),               title: 'Connexion',             caption: 'Connectez-vous pour synchroniser votre profil, vos statistiques et votre abonnement entre appareils.' },
    { image: shot('register'),            title: 'Créez un compte',       caption: 'Une inscription rapide débloque le jeu en ligne, les Clubs et les Tournois.' },
    { image: shot('settings'),            title: 'Réglages',              caption: 'Adaptez l’app à votre style de table — son, thèmes et options de jeu.' },
    { image: shot('settings-animations'), title: 'Animations',            caption: 'Réglez la vitesse des animations de distribution et de jeu — vive ou cinématique, à vous de choisir.' },
  ],
  de: [
    { image: shot('slide-menu'),          title: 'Alles griffbereit',   caption: 'Profil, Einstellungen und rechtliche Infos in einem Ausklappmenü — spiel als Gast oder melde dich an.' },
    { image: shot('profile'),             title: 'Dein Profil',         caption: 'Wähl einen Avatar und einen Anzeigenamen — so sehen dich andere Spieler in Lobbys und Räumen.' },
    { image: shot('login'),               title: 'Anmelden',            caption: 'Melde dich an, um Profil, Statistiken und Abo geräteübergreifend zu synchronisieren.' },
    { image: shot('register'),            title: 'Konto erstellen',     caption: 'Eine schnelle Registrierung schaltet Online-Spiele, Clubs und Turniere frei.' },
    { image: shot('settings'),            title: 'Einstellungen',       caption: 'Stimm die App auf deinen Tischstil ab — Sound, Themes und Gameplay-Optionen.' },
    { image: shot('settings-animations'), title: 'Animationen',         caption: 'Stell die Geschwindigkeit der Geber- und Kartenanimationen ein — flott oder filmreif, du entscheidest.' },
  ],
  hi: [
    { image: shot('slide-menu'),          title: 'सब कुछ पहुँच में',     caption: 'प्रोफ़ाइल, सेटिंग्स और क़ानूनी जानकारी एक स्लाइड-आउट मेन्यू में — मेहमान के तौर पर खेलें या लॉगिन करें।' },
    { image: shot('profile'),             title: 'आपकी प्रोफ़ाइल',       caption: 'अवतार और डिस्प्ले नाम चुनें — लॉबी और रूम में खिलाड़ी आपको ऐसे ही देखेंगे।' },
    { image: shot('login'),               title: 'साइन इन करें',         caption: 'अपनी प्रोफ़ाइल, आँकड़े और सब्सक्रिप्शन सभी डिवाइस पर सिंक करने के लिए लॉगिन करें।' },
    { image: shot('register'),            title: 'खाता बनाएँ',           caption: 'एक झटपट रजिस्ट्रेशन से ऑनलाइन खेल, क्लब और टूर्नामेंट खुल जाते हैं।' },
    { image: shot('settings'),            title: 'सेटिंग्स',             caption: 'ऐप को अपने टेबल स्टाइल के हिसाब से ढालें — साउंड, थीम और गेमप्ले विकल्प।' },
    { image: shot('settings-animations'), title: 'एनिमेशन',             caption: 'कार्ड बाँटने और चाल की एनिमेशन गति चुनें — फुर्तीली या सिनेमाई, आपकी मर्ज़ी।' },
  ],
};

const sectionCopy = {
  en: { tag: '♠ Inside the App', title: 'Take the Tour', subtitle: 'Real screens from the app — a beautifully crafted card table in your pocket.' },
  es: { tag: '♠ Dentro de la app', title: 'Haz el recorrido', subtitle: 'Pantallas reales de la app — una mesa de cartas bellamente cuidada en tu bolsillo.' },
  pt: { tag: '♠ Por dentro do app', title: 'Faça o tour', subtitle: 'Telas reais do app — uma mesa de cartas primorosamente acabada no seu bolso.' },
  fr: { tag: '♠ Au cœur de l’app', title: 'Faites le tour', subtitle: 'De vrais écrans de l’app — une table de cartes magnifiquement soignée dans votre poche.' },
  de: { tag: '♠ Ein Blick in die App', title: 'Mach die Tour', subtitle: 'Echte Screens aus der App — ein liebevoll gestalteter Kartentisch für deine Hosentasche.' },
  hi: { tag: '♠ ऐप के अंदर', title: 'टूर कीजिए', subtitle: 'ऐप की असली स्क्रीनें — शानदार ढंग से तैयार की गई ताश की टेबल आपकी जेब में।' },
}[lang];

const featured = featuredByLang[lang];
const tour     = tourByLang[lang];

/* Combined list drives the lightbox gallery; index order matches page order */
const allShots = [...featured, ...tour];
---
<section class="showcase" id="app-tour">
  <div class="container">
    <div class="section-header">
      <div class="section-tag">{sectionCopy.tag}</div>
      <h2 class="section-title">{sectionCopy.title}</h2>
      <p class="section-subtitle">{sectionCopy.subtitle}</p>
    </div>

    <div class="showcase-featured">
      {featured.map((s, i) => (
        <figure class="shot-card shot-card--featured">
          <button class="shot-zoom" data-idx={i} aria-label={`View ${s.title} screenshot full size`}>
            <Image
              src={s.image}
              alt={`Card Games app — ${s.title}`}
              width={720}
              widths={[280, 480, 720]}
              sizes="(max-width: 640px) 90vw, (max-width: 980px) 45vw, 310px"
              quality={70}
              class="shot-img"
            />
          </button>
          <figcaption>
            <strong>{s.title}</strong>
            <span>{s.caption}</span>
          </figcaption>
        </figure>
      ))}
    </div>

    <div class="showcase-tour">
      {tour.map((s, i) => (
        <figure class="shot-card">
          <button class="shot-zoom" data-idx={featured.length + i} aria-label={`View ${s.title} screenshot full size`}>
            <Image
              src={s.image}
              alt={`Card Games app — ${s.title}`}
              width={600}
              widths={[220, 400, 600]}
              sizes="(max-width: 640px) 45vw, (max-width: 980px) 30vw, 240px"
              quality={70}
              class="shot-img"
            />
          </button>
          <figcaption>
            <strong>{s.title}</strong>
            <span>{s.caption}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>

  <ScreenshotLightbox shots={allShots} altPrefix="Card Games app" />
</section>

<style>
  .showcase {
    background: var(--bg-deep);
    border-top: 1px solid var(--border);
    padding: 5rem 0;
  }

  .showcase-featured {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
    max-width: 980px;
    margin: 0 auto 1.5rem;
  }

  .showcase-tour {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1.25rem;
    max-width: 980px;
    margin: 0 auto;
  }

  .shot-card {
    margin: 0;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: all var(--transition);
  }
  .shot-card--featured { border-color: var(--gold-border); }
  .shot-card:hover {
    border-color: var(--gold-border);
    transform: translateY(-3px);
    box-shadow: var(--shadow-md), var(--glow-gold);
  }
  .shot-card :global(.shot-img) { display: block; width: 100%; height: auto; }
  .shot-card figcaption { padding: .85rem 1rem 1rem; }
  .shot-card figcaption strong {
    display: block; font-size: .85rem; color: var(--text-primary);
    font-family: 'Inter Variable',sans-serif; margin-bottom: .25rem;
  }
  .shot-card figcaption span {
    font-size: .78rem; color: var(--text-muted); line-height: 1.55;
  }

  .shot-zoom {
    display: block; width: 100%; padding: 0; margin: 0;
    background: none; border: none; cursor: zoom-in;
  }
</style>
