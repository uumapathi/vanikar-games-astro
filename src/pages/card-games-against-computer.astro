---
import BaseLayout     from '../layouts/BaseLayout.astro';
import FeatureLanding from '../components/FeatureLanding.astro';

const faqs = [
  { q: 'Which card games can I play against the computer?',
    a: 'Every Vanikar game supports AI opponents — Hearts, Spades, Gin Rummy, Cribbage, Big Two, Indian Rummy, Durak, Belote, High Card, and Bluff, with more games on the way.' },
  { q: 'Can I choose the AI difficulty?',
    a: 'Yes. Each AI opponent has selectable difficulty levels, so you can learn a new game against a gentle opponent and work your way up to a real challenge.' },
  { q: 'Is playing against the computer good practice for online play?',
    a: 'Definitely. AI games use exactly the same rules as live tables, so everything you practice — bidding, card counting, timing — carries straight over to games with real players.' },
  { q: 'Do I need internet to play against the computer?',
    a: 'No — AI games work fully offline. Play on a flight, on the subway, or anywhere without a connection.' },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://vanikar.games/' },
      { '@type': 'ListItem', position: 2, name: 'Card Games Against Computer', item: 'https://vanikar.games/card-games-against-computer/' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---
<BaseLayout
  title="Card Games Against the Computer – Play vs Smart AI | Vanikar"
  description="Play card games against the computer with smart AI opponents and multiple difficulty levels. Practice Hearts, Spades, Gin Rummy, Cribbage and more — online or fully offline."
>
  <Fragment slot="head">
    {jsonLd.map(schema => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </Fragment>

  <FeatureLanding
    h1="Play Card Games Against the Computer"
    intro="Learn faster and play anytime with Vanikar's smart AI opponents. Every game in the collection can be played against the computer — with adjustable difficulty, instant restarts, and no internet required."
    sections={[
      { heading: 'Smart AI, honest play',
        body: 'Vanikar’s AI opponents play by the same rules and see the same cards a human would. They bid, bluff, and count cards — they never peek at your hand.' },
      { heading: 'Difficulty that grows with you',
        body: 'Start on an easier setting while you learn the ropes, then raise the difficulty as your strategy sharpens. Every level up is progress you actually earned.' },
      { heading: 'The perfect practice ground',
        body: 'Trying a new game or testing a risky strategy? Against the computer there’s no waiting and no pressure — restart as often as you like until it clicks.' },
      { heading: 'Play solo, anytime, anywhere',
        body: 'AI games start instantly and work completely offline. Five minutes in a waiting room is enough for a quick hand of Gin Rummy against the computer.' },
    ]}
    faqs={faqs}
    gamesHeading="Games with AI opponents"
    gamesSub="Every game supports computer opponents with multiple difficulty levels."
  />
</BaseLayout>
