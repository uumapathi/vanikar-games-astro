---
import BaseLayout            from '../../layouts/BaseLayout.astro';
import HeroSection           from '../../components/HeroSection.astro';
import NoAdsSection         from '../../components/NoAdsSection.astro';
import StatsSection          from '../../components/StatsSection.astro';
import GamesMarquee          from '../../components/GamesMarquee.astro';
import FeaturesSection       from '../../components/FeaturesSection.astro';
import AppShowcaseSection    from '../../components/AppShowcaseSection.astro';
import SocialFeaturesSection from '../../components/SocialFeaturesSection.astro';
import PricingSection        from '../../components/PricingSection.astro';
import HomeFaqSection        from '../../components/HomeFaqSection.astro';
import DownloadSection       from '../../components/DownloadSection.astro';
import { games, availableGames } from '../../data/games';
import { getLocale, localizedHref, rootHref, useTranslations } from '../../i18n';

const lang = getLocale(Astro.currentLocale);
const t = useTranslations(lang);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Vanikar LLC',
    url: 'https://vanikar.com',
    logo: new URL('/icon-180.png', Astro.site).href,
    sameAs: [Astro.site!.href],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Card Games by Vanikar',
    operatingSystem: 'iOS, Android',
    applicationCategory: 'GameApplication',
    applicationSubCategory: 'Card Game',
    description: `Play ${availableGames.length} classic card games online or offline — Hearts, Spades, Gin Rummy, Cribbage, Big Two, Indian Rummy and more — against AI, friends, or online players. ${games.length - availableGames.length} more games in development.`,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD', description: 'Free 2-week trial' },
    publisher: { '@type': 'Organization', name: 'Vanikar LLC', url: 'https://vanikar.com' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t('nav.allGames'), item: new URL(rootHref('/', lang), Astro.site).href },
      { '@type': 'ListItem', position: 2, name: t('nav.product'),  item: new URL(localizedHref('/', lang), Astro.site).href },
    ],
  },
];
---
<BaseLayout>
  <Fragment slot="head">
    {jsonLd.map(schema => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </Fragment>
  <HeroSection />
  <NoAdsSection />
  <StatsSection />
  <GamesMarquee />
  <FeaturesSection />
  <AppShowcaseSection />
  <SocialFeaturesSection />
  <PricingSection />
  <HomeFaqSection />
  <DownloadSection />
</BaseLayout>
