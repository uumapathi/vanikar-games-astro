---
import BaseLayout     from '../layouts/BaseLayout.astro';
import FeatureLanding from '../components/FeatureLanding.astro';

const faqs = [
  { q: 'How many players can join a multiplayer game?',
    a: 'It depends on the game — Gin Rummy and Cribbage are head-to-head duels, Hearts and Spades seat four, and games like Bluff and Big Two take up to six players at one table.' },
  { q: 'Can I mix human and AI players at one table?',
    a: 'Yes. Any empty seat at your table can be filled with an AI opponent, so a game never has to wait for a full lobby.' },
  { q: 'Are there team-based multiplayer card games?',
    a: 'Yes — Spades is played in two partnerships of two, and more team games such as Euchre, Canasta, and Court Piece are in development.' },
  { q: 'Do multiplayer games work on both iOS and Android?',
    a: 'Yes. Vanikar is fully cross-platform: iPhone, iPad, and Android players all share the same tables.' },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://vanikar.games/' },
      { '@type': 'ListItem', position: 2, name: 'Multiplayer Card Games', item: 'https://vanikar.games/multiplayer-card-games/' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---
<BaseLayout
  title="Multiplayer Card Games – Play Live With Real Players | Vanikar"
  description="Multiplayer card games at live tables: Hearts, Spades, Big Two, Bluff, Durak, Belote and more. Play 2–6 player games with real people, friends, or AI filling the empty seats."
>
  <Fragment slot="head">
    {jsonLd.map(schema => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </Fragment>

  <FeatureLanding
    h1="Multiplayer Card Games"
    intro="From two-player duels like Gin Rummy and Cribbage to six-player chaos in Bluff, Vanikar's multiplayer card games seat real people at every table — with matchmaking, partnerships, and cross-platform play built in."
    sections={[
      { heading: 'Tables for every group size',
        body: 'Head-to-head, four-hand, or a full table of eight — each game supports its traditional player count, and matchmaking fills the seats with real opponents at your skill level.' },
      { heading: 'Partnership play',
        body: 'Team games like Spades pair you with a partner across the table. Coordinate bids, cover each other’s nil, and win as a team — with more partnership classics on the way.' },
      { heading: 'Never wait for a full lobby',
        body: 'Missing a fourth? Add an AI player to any empty seat and deal immediately. Human players can join or leave between hands without breaking up the table.' },
      { heading: 'One community, every platform',
        body: 'iPhone, iPad, and Android players all share the same tables and leaderboards, so your group can play together no matter what device anyone owns.' },
    ]}
    faqs={faqs}
    gamesHeading="Multiplayer games available now"
    gamesSub="Every title supports live multiplayer — plus AI opponents to fill any empty seat."
  />
</BaseLayout>
