---
import BaseLayout     from '../layouts/BaseLayout.astro';
import FeatureLanding from '../components/FeatureLanding.astro';

const faqs = [
  { q: 'What card games can I play online with Vanikar?',
    a: 'Vanikar currently offers live online play for classic games including Hearts, Spades, Gin Rummy, Cribbage, Big Two, Indian Rummy, Durak, Belote, High Card, and Bluff — with many more in development.' },
  { q: 'Do I play against real people?',
    a: 'Yes. Online tables match you with real players from around the world. You can also fill seats with AI opponents or create a private table just for friends.' },
  { q: 'Is playing card games online free?',
    a: 'The app is free to download on iOS and Android, and every game is fully unlocked for a 2-week free trial — no credit card required.' },
  { q: 'Can I play online card games on both phone and tablet?',
    a: 'Yes. Vanikar runs on iOS and Android phones and tablets, and your account, stats, and friends follow you across devices.' },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://vanikar.games/' },
      { '@type': 'ListItem', position: 2, name: 'Online Card Games', item: 'https://vanikar.games/online-card-games/' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---
<BaseLayout
  title="Play Card Games Online – Live Tables & Real Opponents | Vanikar"
  description="Play card games online at live tables with real opponents — Hearts, Spades, Gin Rummy, Cribbage, Big Two, Durak and more. Quick matches and private tables."
>
  <Fragment slot="head">
    {jsonLd.map(schema => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </Fragment>

  <FeatureLanding
    h1="Play Card Games Online"
    intro="Vanikar brings classic card games to live online tables. Sit down against real opponents from around the world, jump into a quick match, or climb the ranked ladder — every game, one app, on iOS and Android."
    sections={[
      { heading: 'Live tables, real opponents',
        body: 'Every online game is played at a live table against real people. Matchmaking finds you opponents in seconds, so you spend your time playing cards, not waiting in lobbies.' },
      { heading: 'Quick and ranked matches', soon: true,
        body: 'In the mood for a casual hand? Start a quick match. Want your wins to count? Ranked play tracks your rating game by game so you can measure real progress in every title.' },
      { heading: 'Seamless cross-device play',
        body: 'Start a session on your phone during a commute and pick it up on a tablet at home. Your account, friends list, and stats stay in sync everywhere you play.' },
      { heading: 'Fair play, no gimmicks',
        body: 'Card dealing is genuinely random and identical rules apply to every player at the table. No pay-to-win boosts — just classic card games played the way they should be.' },
    ]}
    faqs={faqs}
    gamesHeading="Card games you can play online now"
    gamesSub="Every game supports live online tables, private games with friends, and AI opponents."
  />
</BaseLayout>
